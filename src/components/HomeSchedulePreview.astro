---
// HomeSchedulePreview — compact upcoming-games strip for the homepage.
// Shows the first active event name + upcoming games (limit 5).
// Pages use this as: <HomeSchedulePreview />
import ScheduleTable from '@/components/ScheduleTable.astro';
import { scheduleEvents } from '@/data/schedule';

const activeEvent = scheduleEvents.find(e => e.active);
const eventName   = activeEvent?.name ?? 'Current Season';
---

<section class="section-alt">
  <div class="container">
    <div class="section-header-clean section-header-clean--action" style="margin-bottom:1.8rem">
      <div>
        <div class="section-kicker">Season</div>
        <h2>{eventName} — Upcoming Games</h2>
      </div>
      <div class="section-header-copy">
        <p>Update <code>src/data/schedule.ts</code> each week. Full schedule and standings on the league page.</p>
        <div class="actions">
          <a class="button button-primary button-sm" href="/league">Full schedule &amp; standings →</a>
        </div>
      </div>
    </div>
    <ScheduleTable limit={5} />
  </div>
</section>

<style>
  code { background: var(--surface-soft); padding: .15rem .4rem; border-radius: 6px; font-size: .85em; }
</style>
