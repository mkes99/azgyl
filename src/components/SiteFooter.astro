---
import { siteMeta, parentNav, resourceNav } from '@/data/site-meta';
import { officialLinks } from '@/data/official-links';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand-block">
      <a class="footer-brand" href="/">
        <img src="/assets/brand/logo-transparent.png" alt="Arizona Girls Youth Lacrosse" />
      </a>
      <p>{siteMeta.tagline}</p>
      <p>AZGYL governs statewide rec girls lacrosse in Arizona — setting rules, certifying officials, and coordinating the framework every club plays within.</p>
    </div>
    <div>
      <div class="footer-title">Parents</div>
      <div class="footer-links">
        {parentNav.map(item => <a href={item.href}>{item.label}</a>)}
        <a href="/league">Schedule & standings</a>
      </div>
    </div>
    <div>
      <div class="footer-title">Resources</div>
      <div class="footer-links">
        {resourceNav.filter(item => item.href !== '/resources').map(item => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href="/leadership">Leadership</a>
      </div>
    </div>
    <div>
      <div class="footer-title">Official standards</div>
      <div class="footer-links">
        {officialLinks.slice(0, 3).map(item => (
          <a href={item.href} target="_blank" rel="noreferrer">{item.title}</a>
        ))}
      </div>
    </div>
  </div>
  <div class="container footer-legal">© 2026 Arizona Girls Youth Lacrosse. All rights reserved.</div>
</footer>
