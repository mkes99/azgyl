---
// LeagueSchedule — date-driven schedule.
// Current week is determined purely by today's date.
// No results, no status tracking — the schedule just shows games.
import { scheduleEvents } from '@/data/schedule';
import { getFieldById }   from '@/data/fields';

const DIV_ORDER = ['8U', '10U', '12U', '14U'];

function buildEventData(event: typeof scheduleEvents[0]) {
  const games     = event.games;
  const dates     = [...new Set(games.map(g => g.date))].sort();
  const divisions = DIV_ORDER.filter(d => games.some(g => g.division === d));

  // Today in YYYY-MM-DD local time
  const todayISO = new Date().toLocaleDateString('en-CA');

  // Current week = soonest game date on or after today.
  // Falls back to last date when season is over.
  const currentDate = dates.find(d => d >= todayISO) ?? dates[dates.length - 1];
  const seasonOver  = dates.every(d => d < todayISO);

  const fmtDate   = (iso: string) =>
    new Date(iso + 'T12:00:00').toLocaleDateString('en-US', {
      weekday: 'long', month: 'long', day: 'numeric',
    });
  const fieldLabel   = (id: string) => getFieldById(id)?.label ?? id;
  const fieldVenue   = (id: string) => getFieldById(id)?.venue ?? '';
  const mapUrl       = (id: string) => getFieldById(id)?.mapUrl ?? '#';
  const fieldNote    = (id: string) => getFieldById(id)?.notes ?? '';
  const fieldMapImg  = (id: string) => getFieldById(id)?.fieldMapUrl ?? '';

  return { games, dates, divisions, currentDate, seasonOver, fmtDate, fieldLabel, fieldVenue, mapUrl, fieldNote, fieldMapImg, todayISO };
}

const activeEvents = scheduleEvents.filter(e => e.active);
---

{activeEvents.length === 0 && (
  <section>
    <div class="container">
      <div class="info-panel">
        <div class="section-kicker">No active events</div>
        <h3>Schedule coming soon</h3>
        <p>Add a season and its games in the Schedule Google Sheet and mark it <code>active</code> — see <code>GOOGLE_SHEETS_SETUP.md</code>.</p>
      </div>
    </div>
  </section>
)}

{activeEvents.map(event => {
  const { games, dates, divisions, currentDate, seasonOver, fmtDate, fieldLabel, fieldVenue, mapUrl, fieldNote, fieldMapImg, todayISO } = buildEventData(event);

  return (
    <section class="league-sched-section">
      <div class="container">

        {seasonOver && (
          <div class="season-complete-notice">
            <span>✓</span>
            <div>
              <strong>Season complete</strong>
              <span>All game days have passed. Browse past weeks using the Week filter.</span>
            </div>
          </div>
        )}

        {/* ── Filter bar ─────────────────────────── */}
        <div class="sched-filters" data-sched-filters={event.id}>

          <div class="sched-filter-row">
            <span class="sched-filter-label">Division</span>
            <div class="sched-filter-tabs" role="tablist" aria-label="Filter by division">
              <button class="sched-tab sched-tab--active" data-div-filter="all" role="tab" aria-selected="true">All</button>
              {divisions.map(div => (
                <button class="sched-tab" data-div-filter={div} role="tab" aria-selected="false">{div}</button>
              ))}
            </div>
          </div>

          <div class="sched-filter-row">
            <span class="sched-filter-label">Week</span>
            <div class="sched-filter-tabs" role="tablist" aria-label="Filter by week">
              {dates.map((date, i) => {
                const isPast    = date < todayISO;
                const isCurrent = date === currentDate;
                return (
                  <button
                    class={`sched-tab${isCurrent ? ' sched-tab--active' : ''}${isPast && !isCurrent ? ' sched-tab--past' : ''}`}
                    data-week-filter={date}
                    role="tab"
                    aria-selected={isCurrent ? 'true' : 'false'}
                    title={fmtDate(date)}
                  >
                    Wk {i + 1}
                  </button>
                );
              })}
            </div>
          </div>

        </div>

        {/* ── One panel per week ─────────────────── */}
        {dates.map((date, weekIdx) => {
          const dayGames = games.filter(g => g.date === date);
          const isPast   = date < todayISO;

          // Group by venue — usually one group (the whole league at one
          // host site), but divisions can legitimately be at different
          // venues the same day. Each group gets its own venue heading
          // (map link + warning + field map) shown once, however many
          // games are in it — never repeated per row.
          const venueGroups: { venue: string; field: string; games: typeof dayGames }[] = [];
          for (const g of dayGames) {
            const venue = fieldVenue(g.field);
            let group = venueGroups.find(vg => vg.venue === venue);
            if (!group) {
              group = { venue, field: g.field, games: [] };
              venueGroups.push(group);
            }
            group.games.push(g);
          }

          return (
            <div
              class={`sched-day${date === currentDate ? '' : ' sched-day--hidden'}`}
              data-week-date={date}
            >
              <div class="sched-day-hdr">
                <div>
                  <span class="sched-day-week">
                    Week {weekIdx + 1}
                    {isPast && <span class="week-status-past">Past</span>}
                  </span>
                  <h3 class="sched-day-date">{fmtDate(date)}</h3>
                </div>
              </div>

              {venueGroups.map(group => (
                <div class="sched-venue-group">
                  {group.venue && (
                    <div class="sched-day-venue-row">
                      <a class="sched-day-venue" href={mapUrl(group.field)} target="_blank" rel="noreferrer">
                        {group.venue}
                      </a>
                      {fieldMapImg(group.field) && (
                        <a class="sched-day-fieldmap" href={fieldMapImg(group.field)} target="_blank" rel="noreferrer">
                          Field map
                        </a>
                      )}
                      {fieldNote(group.field) && (
                        <details class="sched-venue-notes">
                          <summary>Notes</summary>
                          <p>{fieldNote(group.field)}</p>
                        </details>
                      )}
                    </div>
                  )}

                  {/* Game list — CSS grid rows, no table */}
                  <div class="sched-list" role="list" aria-label={`Week ${weekIdx + 1} schedule, ${group.venue}`}>
                    <div class="sched-list-header" aria-hidden="true">
                      <span>Div</span>
                      <span>Start</span>
                      <span>Matchup</span>
                      <span class="sl-field-head">Field</span>
                    </div>
                    {group.games.map(g => (
                      <div class="sched-row" role="listitem" data-division={g.division}>
                        <span class="sl-div"><span class="div-chip">{g.division}</span></span>
                        <span class="sl-time">
                          <strong>{g.time}</strong>
                          {g.arrival && <span class="sl-arrive">{g.arrival} arrival</span>}
                        </span>
                        <span class="sl-matchup">
                          <span class="sl-home">{g.home}</span>
                          <span class="sl-vs">vs</span>
                          <span class="sl-away">{g.away}</span>
                          {g.notes && <span class="game-note">{g.notes}</span>}
                        </span>
                        <span class="sl-field">{fieldLabel(g.field)}</span>
                      </div>
                    ))}
                  </div>

                  {/* Mobile cards */}
                  <div class="sched-cards">
                    {group.games.map(g => (
                      <div class="sched-card" data-division={g.division}>
                        <div class="scard-top">
                          <div class="scard-meta">
                            <span class="div-chip">{g.division}</span>
                            <span class="scard-time">{g.time}</span>
                            {g.arrival && <span class="scard-arrive">Arrive {g.arrival}</span>}
                          </div>
                        </div>
                        <div class="scard-matchup">
                          <span class="scard-home">{g.home}</span>
                          <span class="scard-vs">vs</span>
                          <span class="scard-away">{g.away}</span>
                        </div>
                        <span class="scard-field">{fieldLabel(g.field)}</span>
                        {g.notes && <div class="scard-note">{g.notes}</div>}
                      </div>
                    ))}
                  </div>
                </div>
              ))}

            </div>
          );
        })}

      </div>
    </section>
  );
})}

<script is:inline>
(function () {
  document.querySelectorAll('[data-sched-filters]').forEach(function (filterRoot) {
    var section = filterRoot.closest('.league-sched-section');
    if (!section) return;

    var activeDiv  = 'all';
    var activeWeek = (section.querySelector('.sched-day:not(.sched-day--hidden)') || {}).dataset?.weekDate || '';

    function applyFilters() {
      section.querySelectorAll('.sched-day').forEach(function (day) {
        day.classList.toggle('sched-day--hidden', !!activeWeek && day.dataset.weekDate !== activeWeek);
      });
      section.querySelectorAll('.sched-day:not(.sched-day--hidden)').forEach(function (day) {
        day.querySelectorAll('[data-division]').forEach(function (el) {
          el.style.display = (activeDiv === 'all' || el.dataset.division === activeDiv) ? '' : 'none';
        });
      });
    }

    filterRoot.querySelectorAll('[data-div-filter]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeDiv = btn.dataset.divFilter;
        filterRoot.querySelectorAll('[data-div-filter]').forEach(function (b) {
          b.classList.toggle('sched-tab--active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        applyFilters();
      });
    });

    filterRoot.querySelectorAll('[data-week-filter]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeWeek = btn.dataset.weekFilter;
        filterRoot.querySelectorAll('[data-week-filter]').forEach(function (b) {
          b.classList.toggle('sched-tab--active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        applyFilters();
      });
    });
  });
})();
</script>

<style>
  code { background: var(--surface-soft); padding: .15rem .4rem; border-radius: 6px; font-size: .85em; }
  .league-sched-section { padding: clamp(48px, 6vw, 80px) 0; }

  .season-complete-notice {
    display: flex; align-items: flex-start; gap: .85rem;
    padding: .85rem 1.1rem; margin-bottom: 1.25rem;
    background: #dcfce7; border: 1px solid #bbf7d0; border-radius: 14px; font-size: .9rem;
  }
  .season-complete-notice > span { font-size: 1.1rem; flex-shrink: 0; }
  .season-complete-notice strong { display: block; color: #15803d; font-weight: 700; margin-bottom: .1rem; }
  .season-complete-notice span   { color: #166534; }

  /* ── Filters ─────────────────────────────────── */
  .sched-filters {
    display: flex; flex-direction: column; gap: .75rem;
    margin-bottom: 1.75rem; padding: 1rem 1.25rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 18px;
  }
  .sched-filter-row   { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
  .sched-filter-label { font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); white-space: nowrap; min-width: 58px; }
  .sched-filter-tabs  { display: flex; gap: .35rem; flex-wrap: wrap; }

  .sched-tab {
    padding: .4rem .85rem; border-radius: 999px;
    border: 1px solid var(--line-strong); background: var(--surface);
    color: var(--muted); font-size: .82rem; font-weight: 600;
    cursor: pointer; white-space: nowrap;
    transition: background .15s, color .15s, border-color .15s;
  }
  .sched-tab:hover   { background: var(--surface-soft); color: var(--text); border-color: var(--text); }
  /* Active: solid filled — no opacity, full contrast */
  .sched-tab--active {
    background: var(--charcoal);
    color: #fff;
    border-color: var(--charcoal);
    font-weight: 700;
  }
  /* Past weeks: slightly muted text, still fully legible */
  .sched-tab--past {
    color: var(--soft);
    background: var(--surface-soft);
    border-color: var(--line-strong);
  }
  .sched-tab--past:hover { color: var(--text); background: var(--surface-soft); }

  /* ── Day panel ───────────────────────────────── */
  .sched-day--hidden { display: none; }
  .sched-day-hdr { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 1rem; margin-bottom: 1rem; border-bottom: 2px solid var(--line); }
  .sched-day-week { display: block; font-size: .68rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--rose-deep); margin-bottom: .2rem; }
  .week-status-past {
    display: inline-block; margin-left: .5rem;
    padding: .1rem .48rem; border-radius: 999px;
    background: var(--surface-soft); color: var(--soft);
    font-size: .62rem; font-weight: 700; letter-spacing: .06em;
    vertical-align: middle; border: 1px solid var(--line);
  }
  .sched-day-date  { margin: 0 0 .2rem; font-size: 1.3rem; font-weight: 800; color: var(--text); letter-spacing: -.02em; }
  /* One block per venue that day — almost always just one, but can be more
     when divisions are hosted at different parks the same day. */
  .sched-venue-group + .sched-venue-group { margin-top: 2rem; }
  .sched-day-venue-row { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-bottom: .85rem; }
  .sched-day-venue {
    font-size: .88rem;
    color: var(--rose-deep);
    font-weight: 600;
    text-decoration: none;
  }
  .sched-day-venue:hover { text-decoration: underline; }
  .sched-day-fieldmap {
    font-size: .78rem;
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: .15rem .6rem;
  }
  .sched-day-fieldmap:hover { color: var(--rose-deep); border-color: var(--rose-deep); }
  /* Click-to-open, not a hover tooltip — shows for any venue note, not
     just ones that happen to sound like a warning. Sits compact next to
     the venue/field-map links when closed; flex-basis:100% pushes it (and
     its revealed text) onto its own full-width line once opened, rather
     than squeezing the note into a narrow shared-row column. */
  .sched-venue-notes[open] { flex-basis: 100%; }
  .sched-venue-notes summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    font-size: .78rem;
    font-weight: 600;
    color: var(--muted);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: .15rem .6rem;
  }
  .sched-venue-notes summary::-webkit-details-marker { display: none; }
  .sched-venue-notes summary:hover,
  .sched-venue-notes[open] summary { color: var(--rose-deep); border-color: var(--rose-deep); }
  .sched-venue-notes p {
    margin-top: .5rem;
    padding: .65rem .85rem;
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: .82rem;
    color: var(--muted);
    max-width: 480px;
  }

  /* ── Game list ───────────────────────────────── */
  .sched-list {
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
  }
  .sched-list-header,
  .sched-row {
    display: grid;
    grid-template-columns: 64px 110px 1fr 200px;
    align-items: center;
    gap: 0 1rem;
  }
  .sched-list-header {
    background: var(--surface-soft);
    border-bottom: 2px solid var(--line);
    padding: .6rem 1rem;
  }
  .sched-list-header span {
    font-size: .66rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--muted);
  }
  .sl-field-head { text-align: right; }
  .sched-row {
    padding: .78rem 1rem;
    border-bottom: 1px solid var(--line);
    transition: background .12s;
  }
  .sched-row:last-child { border-bottom: none; }
  .sched-row:hover { background: var(--surface-soft); }

  .sl-div  { display: flex; align-items: center; }
  .div-chip {
    display: inline-block; padding: .2rem .55rem; border-radius: 999px;
    font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    background: color-mix(in srgb, var(--olive) 10%, white);
    color: var(--olive);
    border: 1px solid color-mix(in srgb, var(--olive) 16%, white);
    white-space: nowrap;
  }

  .sl-time        { display: flex; flex-direction: column; gap: .1rem; }
  .sl-time strong { font-size: .9rem; color: var(--text); font-weight: 700; }
  .sl-arrive      { font-size: .74rem; color: var(--muted); }

  .sl-matchup { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
  .sl-home    { font-weight: 700; color: var(--olive); font-size: .9rem; }
  .sl-vs      { font-size: .68rem; font-weight: 700; color: var(--soft); text-transform: uppercase; letter-spacing: .06em; flex-shrink: 0; }
  .sl-away    { color: var(--text); font-size: .9rem; }

  .sl-field       { font-size: .84rem; color: var(--muted); text-align: right; white-space: nowrap; }
  /* flex-basis:100% forces this onto its own line within .sl-matchup's
     wrapping flex row, below the home/vs/away, without needing a separate
     grid column — was styled but never rendered until now (see CHANGELOG). */
  .game-note      { font-size: .7rem; color: var(--soft); font-style: italic; flex-basis: 100%; margin-top: .1rem; }

  /* ── Mobile cards ────────────────────────────── */
  .sched-cards { display: none; flex-direction: column; gap: .6rem; }
  .sched-card { border-radius: 16px; border: 1px solid var(--line); background: var(--surface); padding: .9rem 1rem; display: flex; flex-direction: column; gap: .5rem; }
  .scard-top     { display: flex; align-items: flex-start; justify-content: space-between; gap: .5rem; }
  .scard-meta    { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .scard-time    { font-size: .88rem; font-weight: 700; color: var(--text); }
  .scard-arrive  { font-size: .76rem; color: var(--muted); }
  .scard-matchup { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
  .scard-home    { font-weight: 800; color: var(--olive); font-size: .95rem; }
  .scard-vs      { font-size: .7rem; font-weight: 700; color: var(--soft); text-transform: uppercase; }
  .scard-away    { color: var(--text); font-size: .95rem; }
  .scard-field   { font-size: .8rem; }
  .scard-note    { font-size: .76rem; color: var(--soft); font-style: italic; padding-top: .25rem; border-top: 1px solid var(--line); }

  @media (max-width: 760px) {
    .sched-list { display: none; }
    .sched-cards { display: flex; }
    .sched-filter-label { min-width: 50px; }
  }
</style>
