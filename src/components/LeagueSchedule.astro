---
// LeagueSchedule — renders all active season/tournament schedule sections.
// Pages use this as: <LeagueSchedule />
// No props needed. All logic lives here.
import ScheduleTable from '@/components/ScheduleTable.astro';
import { scheduleEvents } from '@/data/schedule';

const activeEvents = scheduleEvents.filter(e => e.active);
---

{activeEvents.length === 0 && (
  <section>
    <div class="container">
      <div class="info-panel">
        <div class="section-kicker">No active events</div>
        <h3>Schedule coming soon</h3>
        <p>
          Open <code>src/data/schedule.ts</code>, add your games,
          and set <code>active: true</code> on the event.
        </p>
      </div>
    </div>
  </section>
)}

{activeEvents.map(event => (
  <section>
    <div class="container">
      <div class="section-header-clean section-header-clean--action" style="margin-bottom:1.8rem">
        <div>
          <div class="section-kicker">
            {event.type === 'tournament' ? 'Tournament' : 'Season'}
          </div>
          <h2>{event.name} — Schedule</h2>
        </div>
        <div class="section-header-copy">
          <p>
            {event.startDate} through {event.endDate}.
            Update <code>src/data/schedule.ts</code> each week.
          </p>
        </div>
      </div>
      <ScheduleTable eventId={event.id} groupBy="division" />
    </div>
  </section>
))}

<style>
  code { background: var(--surface-soft); padding: .15rem .4rem; border-radius: 6px; font-size: .85em; }
</style>
