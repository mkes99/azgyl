---
// LeagueSchedule — date-driven schedule.
// Current week is determined purely by today's date.
// No results, no status tracking — the schedule just shows games.
import { scheduleEvents } from '@/data/schedule';
import { getVenueById }   from '@/data/venues';

const DIV_ORDER = ['8U', '10U', '12U', '14U'];

function buildEventData(event: typeof scheduleEvents[0]) {
  const games     = event.games;
  const dates     = [...new Set(games.map(g => g.date))].sort();
  const divisions = DIV_ORDER.filter(d => games.some(g => g.division === d));
  // Built from this event's own games, not the full roster in teams.ts —
  // not every team plays every season, so the filter should only ever
  // offer teams that actually show up here.
  const teamNames = [...new Set(games.flatMap(g => [g.home, g.away]))].sort();

  // Today in YYYY-MM-DD local time
  const todayISO = new Date().toLocaleDateString('en-CA');

  // Current week = soonest game date on or after today.
  // Falls back to last date when season is over.
  const currentDate = dates.find(d => d >= todayISO) ?? dates[dates.length - 1];
  // `dates.every(...)` on an empty array is vacuously true in JS — an
  // active event with zero games (Schedule tab has a season row but no
  // game rows yet, or every game row failed to parse) would otherwise
  // read as "season complete" instead of "nothing scheduled yet". Those
  // are different states and shouldn't share a banner.
  const seasonOver  = dates.length > 0 && dates.every(d => d < todayISO);

  const fmtDate     = (iso: string) =>
    new Date(iso + 'T12:00:00').toLocaleDateString('en-US', {
      weekday: 'long', month: 'long', day: 'numeric',
    });
  const venueName    = (id: string) => getVenueById(id)?.name ?? id;
  const venueAddress = (id: string) => getVenueById(id)?.address ?? '';
  const mapUrl        = (id: string) => getVenueById(id)?.mapUrl ?? '#';
  // `override` is a game's own fieldMapUrl/venueNotes, typed on the sheet
  // alongside `venue` and filled down the same block — wins over the
  // hardcoded venues.ts value when present, since it's the more current
  // one.
  const venueMapImg   = (id: string, override?: string) => override || getVenueById(id)?.fieldMapUrl || '';
  const venueNote     = (id: string, override?: string) => override || getVenueById(id)?.notes || '';

  return { games, dates, divisions, teamNames, currentDate, seasonOver, fmtDate, venueName, venueAddress, mapUrl, venueNote, venueMapImg, todayISO };
}

const activeEvents = scheduleEvents.filter(e => e.active);

// More than one season/tournament can be active at once (see
// GOOGLE_SHEETS_SETUP.md) — a season plus a tournament running
// alongside it, or a real overlap while one season's winding down and
// the next hasn't started. When that happens, only one is shown at a
// time (a season switcher below lets a visitor pick another), and the
// default has to be a real decision, not just whichever sheet row
// happens to be listed first. Same "soonest upcoming game wins" rule
// HomeSchedulePreview.astro uses for its single-event pick, so the
// homepage and /league never disagree about which season is "current"
// for the same visitor on the same day. Falls back to the first active
// event if none of them have an upcoming game (everything active is
// finished or empty).
function soonestUpcoming(evt: typeof scheduleEvents[0]) {
  const dates = [...new Set(evt.games.map(g => g.date))].sort();
  const todayISO = new Date().toLocaleDateString('en-CA');
  return dates.find(d => d >= todayISO) ?? null;
}
const defaultEvent = activeEvents.reduce((best, evt) => {
  const nextForEvt = soonestUpcoming(evt);
  if (!nextForEvt) return best;
  const nextForBest = best ? soonestUpcoming(best) : null;
  return (!best || !nextForBest || nextForEvt < nextForBest) ? evt : best;
}, null as typeof scheduleEvents[0] | null) ?? activeEvents[0];
const defaultEventId = defaultEvent?.id;
---

{activeEvents.length === 0 && (
  <section>
    <div class="container">
      <div class="info-panel">
        <div class="section-kicker">No active events</div>
        <h3>Schedule coming soon</h3>
        <p>Add a season and its games in the Schedule Google Sheet and mark it <code>active</code> — see <code>GOOGLE_SHEETS_SETUP.md</code>.</p>
      </div>
    </div>
  </section>
)}

{activeEvents.length > 0 && (
  <section class="league-sched-section">
    <div class="container">

      {/* ── Season switcher ───────────────────────
          Only shown when there's actually a choice to make. Doubles as
          the "which season am I looking at" label — Season isn't a
          filter like Division/Week/Team below (those subtract from one
          shared list of games; a season IS the list), so unlike those
          three, this never gets an "All" option — it always resolves to
          exactly one selected season. See sheets-branch-merge-plan
          memory / this session's design discussion for why. */}
      {activeEvents.length > 1 ? (
        <div class="season-switcher" role="tablist" aria-label="Select season">
          {activeEvents.map(event => (
            <button
              type="button"
              class={`season-tab${event.id === defaultEventId ? ' season-tab--active' : ''}`}
              data-season-tab={event.id}
              role="tab"
              aria-selected={event.id === defaultEventId ? 'true' : 'false'}
            >
              {event.name}
            </button>
          ))}
        </div>
      ) : (
        <h2 class="season-name">{activeEvents[0].name}</h2>
      )}

      {activeEvents.map(event => {
        const { games, dates, divisions, teamNames, currentDate, seasonOver, fmtDate, venueName, venueAddress, mapUrl, venueNote, venueMapImg, todayISO } = buildEventData(event);
        const isDefaultSeason = event.id === defaultEventId;

        return (
        <div class="season-block" data-season-block={event.id} hidden={!isDefaultSeason}>

        {seasonOver && (
          <div class="season-complete-notice">
            <span>✓</span>
            <div>
              <strong>Season complete</strong>
              <span>All game days have passed. Browse past weeks using the Week filter.</span>
            </div>
          </div>
        )}

        {/* An active event with zero games — a season row exists in the
            sheet but the Schedule tab has no game rows for it yet (or
            none parsed) — gets its own notice instead of an empty filter
            bar with nothing beneath it. Season name already shown above
            (switcher tab or the plain heading), so no need to repeat it
            here. */}
        {dates.length === 0 && (
          <div class="info-panel">
            <h3>No games scheduled yet</h3>
            <p>This season is active but the Schedule tab doesn't have any games for it yet.</p>
          </div>
        )}

        {dates.length > 0 && (<>
        {/* ── Filter bar ─────────────────────────── */}
        <div class="sched-filters" data-sched-filters={event.id}>

          <div class="sched-filter-row">
            <span class="sched-filter-label">Division</span>
            <div class="sched-filter-tabs" role="tablist" aria-label="Filter by division">
              <button class="sched-tab sched-tab--active" data-div-filter="all" role="tab" aria-selected="true">All</button>
              {divisions.map(div => (
                <button class="sched-tab" data-div-filter={div} role="tab" aria-selected="false">{div}</button>
              ))}
            </div>
          </div>

          <div class="sched-filter-row">
            <span class="sched-filter-label">Week</span>
            <div class="sched-filter-tabs" role="tablist" aria-label="Filter by week">
              <button class="sched-tab" data-week-filter="all" role="tab" aria-selected="false">All</button>
              {dates.map((date, i) => {
                const isPast    = date < todayISO;
                const isCurrent = date === currentDate;
                return (
                  <button
                    class={`sched-tab${isCurrent ? ' sched-tab--active' : ''}${isPast ? ' sched-tab--past' : ''}`}
                    data-week-filter={date}
                    role="tab"
                    aria-selected={isCurrent ? 'true' : 'false'}
                    title={fmtDate(date)}
                  >
                    Wk {i + 1}
                  </button>
                );
              })}
            </div>
          </div>

          <div class="sched-filter-row">
            <span class="sched-filter-label">Team</span>
            <div class="sched-filter-tabs" role="tablist" aria-label="Filter by team">
              <button class="sched-tab sched-tab--active" data-team-filter="all" role="tab" aria-selected="true">All</button>
              {teamNames.map(team => (
                <button class="sched-tab" data-team-filter={team} role="tab" aria-selected="false">{team}</button>
              ))}
            </div>
          </div>

        </div>

        {/* ── One panel per week ─────────────────── */}
        {dates.map((date, weekIdx) => {
          const dayGames = games.filter(g => g.date === date);
          const isPast   = date < todayISO;

          // Group by venue — usually one group (the whole league at one
          // host site), but divisions can legitimately be at different
          // venues the same day. Each group gets its own venue heading
          // (map link + warning + field map) shown once, however many
          // games are in it — never repeated per row. Grouping key is the
          // venue id straight off each game — no lookup needed to know
          // which games share a venue.
          const venueGroups: { venue: string; games: typeof dayGames }[] = [];
          for (const g of dayGames) {
            let group = venueGroups.find(vg => vg.venue === g.venue);
            if (!group) {
              group = { venue: g.venue, games: [] };
              venueGroups.push(group);
            }
            group.games.push(g);
          }

          return (
            <div
              class={`sched-day${date === currentDate ? '' : ' sched-day--hidden'}`}
              data-week-date={date}
            >
              <div class="sched-day-hdr">
                <div>
                  <span class="sched-day-week">
                    Week {weekIdx + 1}
                    {isPast && <span class="week-status-past">Past</span>}
                  </span>
                  <h3 class="sched-day-date">{fmtDate(date)}</h3>
                </div>
              </div>

              {venueGroups.map(group => (
                <div class="sched-venue-group">
                  {group.venue && (
                    <div class="sched-day-venue-row">
                      <a class="sched-day-venue" href={mapUrl(group.venue)} target="_blank" rel="noreferrer">
                        {venueName(group.venue)}
                      </a>
                      {venueMapImg(group.venue, group.games[0]?.fieldMapUrl) && (
                        <a class="sched-day-fieldmap" href={venueMapImg(group.venue, group.games[0]?.fieldMapUrl)} target="_blank" rel="noreferrer">
                          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M7 3.5 3 5v11.5l4-1.5 6 2 4-1.5V4l-4 1.5-6-2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                            <path d="M7 3.5v11.5M13 5.5V17" stroke="currentColor" stroke-width="1.4"/>
                          </svg>
                          Field map
                        </a>
                      )}
                      {venueNote(group.venue, group.games[0]?.venueNotes) && (
                        <div class="sched-venue-notes">
                          <button type="button" class="sched-venue-notes-toggle" aria-expanded="false">Notes</button>
                          <p hidden>{venueNote(group.venue, group.games[0]?.venueNotes)}</p>
                        </div>
                      )}
                    </div>
                  )}
                  {venueAddress(group.venue) && (
                    <p class="sched-day-address">{venueAddress(group.venue)}</p>
                  )}

                  {/* Game list — CSS grid rows, no table */}
                  <div class="sched-list" role="list" aria-label={`Week ${weekIdx + 1} schedule, ${venueName(group.venue)}`}>
                    <div class="sched-list-header" aria-hidden="true">
                      <span>Div</span>
                      <span>Start</span>
                      <span>Matchup</span>
                      <span class="sl-field-head">Field</span>
                    </div>
                    {group.games.map(g => (
                      <div class="sched-row" role="listitem" data-division={g.division} data-home={g.home} data-away={g.away}>
                        <span class="sl-div"><span class="div-chip">{g.division}</span></span>
                        <span class="sl-time">
                          <strong>{g.time}</strong>
                          {g.arrival && <span class="sl-arrive">{g.arrival} arrival</span>}
                        </span>
                        <span class="sl-matchup">
                          <span class="sl-home">{g.home}</span>
                          <span class="sl-vs">vs</span>
                          <span class="sl-away">{g.away}</span>
                          {g.gameNotes && <span class="game-note">{g.gameNotes}</span>}
                        </span>
                        <span class="sl-field">{g.field}</span>
                      </div>
                    ))}
                  </div>

                  {/* Mobile cards */}
                  <div class="sched-cards">
                    {group.games.map(g => (
                      <div class="sched-card" data-division={g.division} data-home={g.home} data-away={g.away}>
                        <div class="scard-top">
                          <div class="scard-meta">
                            <span class="div-chip">{g.division}</span>
                            <span class="scard-time">{g.time}</span>
                            {g.arrival && <span class="scard-arrive">Arrive {g.arrival}</span>}
                          </div>
                        </div>
                        <div class="scard-matchup">
                          <span class="scard-home">{g.home}</span>
                          <span class="scard-vs">vs</span>
                          <span class="scard-away">{g.away}</span>
                        </div>
                        <span class="scard-field">{g.field}</span>
                        {g.gameNotes && <div class="scard-note">{g.gameNotes}</div>}
                      </div>
                    ))}
                  </div>
                </div>
              ))}

            </div>
          );
        })}
        </>)}

        </div>
        );
      })}

    </div>
  </section>
)}

{/* Single reusable lightbox for every "Field map" link on the page —
    populated with whichever image was clicked (see the script below). */}
<div class="fieldmap-lightbox" id="fieldmap-lightbox" hidden>
  <button type="button" class="fieldmap-lightbox-backdrop" aria-label="Close field map"></button>
  <figure class="fieldmap-lightbox-figure">
    <button type="button" class="fieldmap-lightbox-close" aria-label="Close field map">&times;</button>
    <img class="fieldmap-lightbox-img" src="" alt="Field map" />
    {/* Shown instead of the image if it fails to load (e.g. a Drive
        hiccup) — the link still opens the source directly rather than
        leaving a permanently broken image icon with no way forward. */}
    <p class="fieldmap-lightbox-fallback" hidden>
      Couldn't load the field map image.
      <a class="fieldmap-lightbox-fallback-link" href="" target="_blank" rel="noreferrer">Open it directly</a>
    </p>
  </figure>
</div>

<script is:inline>
(function () {
  // Season switcher — shows exactly one .season-block at a time. Only
  // rendered as clickable tabs when there's more than one active
  // season; with just one, the block is already the default and
  // there's nothing to wire up here.
  document.querySelectorAll('[data-season-tab]').forEach(function (tab) {
    tab.addEventListener('click', function () {
      var id = tab.dataset.seasonTab;
      document.querySelectorAll('[data-season-tab]').forEach(function (t) {
        t.classList.toggle('season-tab--active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      document.querySelectorAll('[data-season-block]').forEach(function (block) {
        block.hidden = block.dataset.seasonBlock !== id;
      });
    });
  });

  document.querySelectorAll('[data-sched-filters]').forEach(function (filterRoot) {
    // Scoped to .season-block, not .league-sched-section — there's now
    // one .league-sched-section wrapping every active season's block,
    // so .league-sched-section would match every season's games at
    // once instead of just this filter bar's own season.
    var section = filterRoot.closest('.season-block');
    if (!section) return;

    var activeDiv  = 'all';
    var activeTeam = 'all';
    var activeWeek = (section.querySelector('.sched-day:not(.sched-day--hidden)') || {}).dataset?.weekDate || '';

    // Division, Week, and Team all combine (AND) — a row has to satisfy
    // whichever of the three are active, not just one of them.
    function rowMatches(el) {
      var divMatch  = activeDiv === 'all' || el.dataset.division === activeDiv;
      var teamMatch = activeTeam === 'all' || el.dataset.home === activeTeam || el.dataset.away === activeTeam;
      return divMatch && teamMatch;
    }

    function applyFilters() {
      section.querySelectorAll('.sched-day').forEach(function (day) {
        day.classList.toggle('sched-day--hidden', !!activeWeek && day.dataset.weekDate !== activeWeek);
      });
      section.querySelectorAll('.sched-day:not(.sched-day--hidden)').forEach(function (day) {
        day.querySelectorAll('[data-division]').forEach(function (el) {
          el.style.display = rowMatches(el) ? '' : 'none';
        });
        // A venue group can end up with every one of its games filtered
        // out (e.g. a division-only host at a venue, filtered to a
        // different division, or a team that didn't play there) — hide
        // the whole group, not just leave its heading sitting above an
        // empty table.
        day.querySelectorAll('.sched-venue-group').forEach(function (group) {
          var hasMatch = Array.prototype.some.call(group.querySelectorAll('[data-division]'), rowMatches);
          group.style.display = hasMatch ? '' : 'none';
        });
      });
    }

    filterRoot.querySelectorAll('[data-div-filter]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeDiv = btn.dataset.divFilter;
        filterRoot.querySelectorAll('[data-div-filter]').forEach(function (b) {
          b.classList.toggle('sched-tab--active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        applyFilters();
      });
    });

    filterRoot.querySelectorAll('[data-team-filter]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeTeam = btn.dataset.teamFilter;
        filterRoot.querySelectorAll('[data-team-filter]').forEach(function (b) {
          b.classList.toggle('sched-tab--active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        applyFilters();
      });
    });

    filterRoot.querySelectorAll('[data-week-filter]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeWeek = btn.dataset.weekFilter === 'all' ? '' : btn.dataset.weekFilter;
        filterRoot.querySelectorAll('[data-week-filter]').forEach(function (b) {
          b.classList.toggle('sched-tab--active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        applyFilters();
      });
    });
  });

  // Notes popover: left-anchored by default. Venue names of varying
  // length put the button at an unpredictable horizontal position, so on
  // narrow screens the box can run past the right edge of the viewport —
  // shift it left by exactly the overflow amount (never more, so it can
  // never push past the LEFT edge either: shifting by the full overflow
  // always lands the box's left edge at `innerWidth - boxWidth`, which is
  // safe as long as the box itself is narrower than the viewport, which
  // its max-width already guarantees). The caret gets nudged the same
  // amount in the opposite direction so it still points at the button.
  // Recomputed on open AND on window resize — a box left open while the
  // window is dragged narrower (or the device rotates) would otherwise
  // keep whatever shift (or none) was correct for the old width.
  function applyNotesOverflowShift(wrap) {
    var p = wrap.querySelector('p');
    if (!p) return;
    p.style.transform = '';
    p.style.removeProperty('--caret-shift');
    if (p.hidden) return;
    var overflow = p.getBoundingClientRect().right - window.innerWidth + 8;
    if (overflow > 0) {
      p.style.transform = 'translateX(-' + overflow + 'px)';
      p.style.setProperty('--caret-shift', overflow + 'px');
    }
  }
  var allNotes = document.querySelectorAll('.sched-venue-notes');
  allNotes.forEach(function (wrap) {
    var toggle = wrap.querySelector('.sched-venue-notes-toggle');
    var p      = wrap.querySelector('p');
    if (!toggle || !p) return;
    toggle.addEventListener('click', function () {
      var opening = p.hidden;
      // Only one open at a time — closing any other open popover avoids
      // two overlapping boxes on a day with several venue groups.
      allNotes.forEach(function (other) {
        if (other === wrap) return;
        var otherP = other.querySelector('p');
        var otherToggle = other.querySelector('.sched-venue-notes-toggle');
        if (otherP && !otherP.hidden) {
          otherP.hidden = true;
          otherToggle.setAttribute('aria-expanded', 'false');
          applyNotesOverflowShift(other);
        }
      });
      p.hidden = !opening;
      toggle.setAttribute('aria-expanded', opening ? 'true' : 'false');
      applyNotesOverflowShift(wrap);
    });
  });
  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      allNotes.forEach(function (wrap) {
        var p = wrap.querySelector('p');
        if (p && !p.hidden) applyNotesOverflowShift(wrap);
      });
    }, 100);
  });

  // Field map lightbox — one shared overlay, populated from whichever
  // "Field map" link was clicked. Falls back to opening the image in a
  // new tab (the link's normal target="_blank" behavior) if the lightbox
  // markup isn't on the page for some reason.
  var lightbox = document.getElementById('fieldmap-lightbox');
  if (lightbox) {
    var lightboxImg      = lightbox.querySelector('.fieldmap-lightbox-img');
    var lightboxFallback = lightbox.querySelector('.fieldmap-lightbox-fallback');
    var lightboxFallbackLink = lightbox.querySelector('.fieldmap-lightbox-fallback-link');
    var openerEl = null;

    // A failed image load (e.g. a transient hiccup from whatever's
    // hosting it) used to leave a permanently broken icon with no way
    // forward — swap in a link to open the source directly instead.
    lightboxImg.addEventListener('error', function () {
      if (!lightboxImg.src) return; // src cleared on close — not a real failure
      lightboxImg.hidden = true;
      lightboxFallbackLink.href = lightboxImg.src;
      lightboxFallback.hidden = false;
    });

    function openLightbox(href, opener) {
      lightboxImg.hidden = false;
      lightboxFallback.hidden = true;
      lightboxImg.src = href;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      openerEl = opener || null;
      lightbox.querySelector('.fieldmap-lightbox-close').focus();
    }
    function closeLightbox() {
      lightbox.hidden = true;
      lightboxImg.src = '';
      document.body.style.overflow = '';
      if (openerEl) openerEl.focus();
    }

    document.querySelectorAll('.sched-day-fieldmap').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        openLightbox(link.href, link);
      });
    });
    lightbox.querySelector('.fieldmap-lightbox-backdrop').addEventListener('click', closeLightbox);
    lightbox.querySelector('.fieldmap-lightbox-close').addEventListener('click', closeLightbox);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });
  }
})();
</script>

<style>
  code { background: var(--surface-soft); padding: .15rem .4rem; border-radius: 6px; font-size: .85em; }
  .league-sched-section { padding: clamp(48px, 6vw, 80px) 0; }

  /* ── Season identity ─────────────────────────── */
  /* The single-season case: a plain heading, not a pill — there's
     nothing to choose between, and this is the primary heading for
     everything below it (the page hero above only says "Schedule and
     standings" generically), so it needs more visual weight than a
     label sitting next to a bigger heading would. */
  .season-name {
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -.01em;
    margin: 0 0 1.75rem;
  }
  /* The multi-season case: underline tabs. Same treatment on
     LeagueStandings.astro's own copy of this switcher — deliberately
     not styled like the Division/Week/Team pill filters below
     (.sched-tab, a different class; this rule is scoped to
     .season-switcher .season-tab specifically) so it still reads as a
     different tier of control than they do, picking which games/
     standings exist to filter in the first place rather than filtering
     within one shared set. */
  .season-switcher {
    display: flex; flex-wrap: wrap;
    gap: .5rem 1.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 2px solid var(--line);
  }
  .season-switcher .season-tab {
    position: relative;
    padding: 0 0 .85rem;
    background: none; border: none;
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    font-weight: 800;
    color: var(--muted);
    cursor: pointer;
    transition: color .15s;
  }
  .season-switcher .season-tab:hover { color: var(--text); }
  .season-switcher .season-tab--active { color: var(--rose-deep); }
  .season-switcher .season-tab--active::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: -2px;
    height: 3px; border-radius: 3px 3px 0 0;
    background: var(--rose-deep);
  }

  .season-complete-notice {
    display: flex; align-items: flex-start; gap: .85rem;
    padding: .85rem 1.1rem; margin-bottom: 1.25rem;
    background: #dcfce7; border: 1px solid #bbf7d0; border-radius: 14px; font-size: .9rem;
  }
