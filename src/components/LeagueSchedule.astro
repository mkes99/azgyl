---
// LeagueSchedule — date-driven schedule.
// Current week is determined purely by today's date.
// No results, no status tracking — the schedule just shows games.
import { scheduleEvents } from '@/data/schedule';
import { getVenueById }   from '@/data/venues';

const DIV_ORDER = ['8U', '10U', '12U', '14U'];

function buildEventData(event: typeof scheduleEvents[0]) {
  const games     = event.games;
  const dates     = [...new Set(games.map(g => g.date))].sort();
  const divisions = DIV_ORDER.filter(d => games.some(g => g.division === d));

  // Today in YYYY-MM-DD local time
  const todayISO = new Date().toLocaleDateString('en-CA');

  // Current week = soonest game date on or after today.
  // Falls back to last date when season is over.
  const currentDate = dates.find(d => d >= todayISO) ?? dates[dates.length - 1];
  // `dates.every(...)` on an empty array is vacuously true in JS — an
  // active event with zero games (Schedule tab has a season row but no
  // game rows yet, or every game row failed to parse) would otherwise
  // read as "season complete" instead of "nothing scheduled yet". Those
  // are different states and shouldn't share a banner.
  const seasonOver  = dates.length > 0 && dates.every(d => d < todayISO);

  const fmtDate     = (iso: string) =>
    new Date(iso + 'T12:00:00').toLocaleDateString('en-US', {
      weekday: 'long', month: 'long', day: 'numeric',
    });
  const venueName    = (id: string) => getVenueById(id)?.name ?? id;
  const venueAddress = (id: string) => getVenueById(id)?.address ?? '';
  const mapUrl        = (id: string) => getVenueById(id)?.mapUrl ?? '#';
  // `override` is a game's own fieldMapUrl/venueNotes, typed on the sheet
  // alongside `venue` and filled down the same block — wins over the
  // hardcoded venues.ts value when present, since it's the more current
  // one.
  const venueMapImg   = (id: string, override?: string) => override || getVenueById(id)?.fieldMapUrl || '';
  const venueNote     = (id: string, override?: string) => override || getVenueById(id)?.notes || '';

  return { games, dates, divisions, currentDate, seasonOver, fmtDate, venueName, venueAddress, mapUrl, venueNote, venueMapImg, todayISO };
}

const activeEvents = scheduleEvents.filter(e => e.active);
---

{activeEvents.length === 0 && (
  <section>
    <div class="container">
      <div class="info-panel">
        <div class="section-kicker">No active events</div>
        <h3>Schedule coming soon</h3>
        <p>Add a season and its games in the Schedule Google Sheet and mark it <code>active</code> — see <code>GOOGLE_SHEETS_SETUP.md</code>.</p>
      </div>
    </div>
  </section>
)}

{activeEvents.map(event => {
  const { games, dates, divisions, currentDate, seasonOver, fmtDate, venueName, venueAddress, mapUrl, venueNote, venueMapImg, todayISO } = buildEventData(event);

  return (
    <section class="league-sched-section">
      <div class="container">

        {seasonOver && (
          <div class="season-complete-notice">
            <span>✓</span>
            <div>
              <strong>Season complete</strong>
              <span>All game days have passed. Browse past weeks using the Week filter.</span>
            </div>
          </div>
        )}

        {/* An active event with zero games — a season row exists in the
            sheet but the Schedule tab has no game rows for it yet (or
            none parsed) — gets its own notice instead of an empty filter
            bar with nothing beneath it. */}
        {dates.length === 0 && (
          <div class="info-panel">
            <div class="section-kicker">{event.name}</div>
            <h3>No games scheduled yet</h3>
            <p>This season is active but the Schedule tab doesn't have any games for it yet.</p>
          </div>
        )}

        {dates.length > 0 && (<>
        {/* ── Filter bar ─────────────────────────── */}
        <div class="sched-filters" data-sched-filters={event.id}>

          <div class="sched-filter-row">
            <span class="sched-filter-label">Division</span>
            <div class="sched-filter-tabs" role="tablist" aria-label="Filter by division">
              <button class="sched-tab sched-tab--active" data-div-filter="all" role="tab" aria-selected="true">All</button>
              {divisions.map(div => (
                <button class="sched-tab" data-div-filter={div} role="tab" aria-selected="false">{div}</button>
              ))}
            </div>
          </div>

          <div class="sched-filter-row">
            <span class="sched-filter-label">Week</span>
            <div class="sched-filter-tabs" role="tablist" aria-label="Filter by week">
              {dates.map((date, i) => {
                const isPast    = date < todayISO;
                const isCurrent = date === currentDate;
                return (
                  <button
                    class={`sched-tab${isCurrent ? ' sched-tab--active' : ''}${isPast && !isCurrent ? ' sched-tab--past' : ''}`}
                    data-week-filter={date}
                    role="tab"
                    aria-selected={isCurrent ? 'true' : 'false'}
                    title={fmtDate(date)}
                  >
                    Wk {i + 1}
                  </button>
                );
              })}
            </div>
          </div>

        </div>

        {/* ── One panel per week ─────────────────── */}
        {dates.map((date, weekIdx) => {
          const dayGames = games.filter(g => g.date === date);
          const isPast   = date < todayISO;

          // Group by venue — usually one group (the whole league at one
          // host site), but divisions can legitimately be at different
          // venues the same day. Each group gets its own venue heading
          // (map link + warning + field map) shown once, however many
          // games are in it — never repeated per row. Grouping key is the
          // venue id straight off each game — no lookup needed to know
          // which games share a venue.
          const venueGroups: { venue: string; games: typeof dayGames }[] = [];
          for (const g of dayGames) {
            let group = venueGroups.find(vg => vg.venue === g.venue);
            if (!group) {
              group = { venue: g.venue, games: [] };
              venueGroups.push(group);
            }
            group.games.push(g);
          }

          return (
            <div
              class={`sched-day${date === currentDate ? '' : ' sched-day--hidden'}`}
              data-week-date={date}
            >
              <div class="sched-day-hdr">
                <div>
                  <span class="sched-day-week">
                    Week {weekIdx + 1}
                    {isPast && <span class="week-status-past">Past</span>}
                  </span>
                  <h3 class="sched-day-date">{fmtDate(date)}</h3>
                </div>
              </div>

              {venueGroups.map(group => (
                <div class="sched-venue-group">
                  {group.venue && (
                    <div class="sched-day-venue-row">
                      <a class="sched-day-venue" href={mapUrl(group.venue)} target="_blank" rel="noreferrer">
                        {venueName(group.venue)}
                      </a>
                      {venueMapImg(group.venue, group.games[0]?.fieldMapUrl) && (
                        <a class="sched-day-fieldmap" href={venueMapImg(group.venue, group.games[0]?.fieldMapUrl)} target="_blank" rel="noreferrer">
                          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M7 3.5 3 5v11.5l4-1.5 6 2 4-1.5V4l-4 1.5-6-2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                            <path d="M7 3.5v11.5M13 5.5V17" stroke="currentColor" stroke-width="1.4"/>
                          </svg>
                          Field map
                        </a>
                      )}
                      {venueNote(group.venue, group.games[0]?.venueNotes) && (
                        <details class="sched-venue-notes">
                          <summary>Notes</summary>
                          <p>{venueNote(group.venue, group.games[0]?.venueNotes)}</p>
                        </details>
                      )}
                    </div>
                  )}
                  {venueAddress(group.venue) && (
                    <p class="sched-day-address">{venueAddress(group.venue)}</p>
                  )}

                  {/* Game list — CSS grid rows, no table */}
                  <div class="sched-list" role="list" aria-label={`Week ${weekIdx + 1} schedule, ${venueName(group.venue)}`}>
                    <div class="sched-list-header" aria-hidden="true">
                      <span>Div</span>
                      <span>Start</span>
                      <span>Matchup</span>
                      <span class="sl-field-head">Field</span>
                    </div>
                    {group.games.map(g => (
                      <div class="sched-row" role="listitem" data-division={g.division}>
                        <span class="sl-div"><span class="div-chip">{g.division}</span></span>
                        <span class="sl-time">
                          <strong>{g.time}</strong>
                          {g.arrival && <span class="sl-arrive">{g.arrival} arrival</span>}
                        </span>
                        <span class="sl-matchup">
                          <span class="sl-home">{g.home}</span>
                          <span class="sl-vs">vs</span>
                          <span class="sl-away">{g.away}</span>
                          {g.gameNotes && <span class="game-note">{g.gameNotes}</span>}
                        </span>
                        <span class="sl-field">{g.field}</span>
                      </div>
                    ))}
                  </div>

                  {/* Mobile cards */}
                  <div class="sched-cards">
                    {group.games.map(g => (
                      <div class="sched-card" data-division={g.division}>
                        <div class="scard-top">
                          <div class="scard-meta">
                            <span class="div-chip">{g.division}</span>
                            <span class="scard-time">{g.time}</span>
                            {g.arrival && <span class="scard-arrive">Arrive {g.arrival}</span>}
                          </div>
                        </div>
                        <div class="scard-matchup">
                          <span class="scard-home">{g.home}</span>
                          <span class="scard-vs">vs</span>
                          <span class="scard-away">{g.away}</span>
                        </div>
                        <span class="scard-field">{g.field}</span>
                        {g.gameNotes && <div class="scard-note">{g.gameNotes}</div>}
                      </div>
                    ))}
                  </div>
                </div>
              ))}

            </div>
          );
        })}
        </>)}

      </div>
    </section>
  );
})}

{/* Single reusable lightbox for every "Field map" link on the page —
    populated with whichever image was clicked (see the script below). */}
<div class="fieldmap-lightbox" id="fieldmap-lightbox" hidden>
  <button type="button" class="fieldmap-lightbox-backdrop" aria-label="Close field map"></button>
  <figure class="fieldmap-lightbox-figure">
    <button type="button" class="fieldmap-lightbox-close" aria-label="Close field map">&times;</button>
    <img class="fieldmap-lightbox-img" src="" alt="Field map" />
  </figure>
</div>

<script is:inline>
(function () {
  document.querySelectorAll('[data-sched-filters]').forEach(function (filterRoot) {
    var section = filterRoot.closest('.league-sched-section');
    if (!section) return;

    var activeDiv  = 'all';
    var activeWeek = (section.querySelector('.sched-day:not(.sched-day--hidden)') || {}).dataset?.weekDate || '';

    function applyFilters() {
      section.querySelectorAll('.sched-day').forEach(function (day) {
        day.classList.toggle('sched-day--hidden', !!activeWeek && day.dataset.weekDate !== activeWeek);
      });
      section.querySelectorAll('.sched-day:not(.sched-day--hidden)').forEach(function (day) {
        day.querySelectorAll('[data-division]').forEach(function (el) {
          el.style.display = (activeDiv === 'all' || el.dataset.division === activeDiv) ? '' : 'none';
        });
        // A venue group can end up with every one of its games filtered
        // out (e.g. a division-only host at a venue, filtered to a
        // different division) — hide the whole group, not just leave its
        // heading sitting above an empty table.
        day.querySelectorAll('.sched-venue-group').forEach(function (group) {
          var hasMatch = activeDiv === 'all' || !!group.querySelector('[data-division="' + activeDiv + '"]');
          group.style.display = hasMatch ? '' : 'none';
        });
      });
    }

    filterRoot.querySelectorAll('[data-div-filter]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeDiv = btn.dataset.divFilter;
        filterRoot.querySelectorAll('[data-div-filter]').forEach(function (b) {
          b.classList.toggle('sched-tab--active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        applyFilters();
      });
    });

    filterRoot.querySelectorAll('[data-week-filter]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeWeek = btn.dataset.weekFilter;
        filterRoot.querySelectorAll('[data-week-filter]').forEach(function (b) {
          b.classList.toggle('sched-tab--active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        applyFilters();
      });
    });
  });

  // Notes popover: left-anchored by default. Venue names of varying
  // length put the button at an unpredictable horizontal position, so on
  // narrow screens the box can run past the right edge of the viewport —
  // shift it left by exactly the overflow amount (never more, so it can
  // never push past the LEFT edge either: shifting by the full overflow
  // always lands the box's left edge at `innerWidth - boxWidth`, which is
  // safe as long as the box itself is narrower than the viewport, which
  // its max-width already guarantees). The caret gets nudged the same
  // amount in the opposite direction so it still points at the button.
  // Recomputed on open AND on window resize — a box left open while the
  // window is dragged narrower (or the device rotates) would otherwise
  // keep whatever shift (or none) was correct for the old width.
  function applyNotesOverflowShift(details) {
    var p = details.querySelector('p');
    if (!p) return;
    p.style.transform = '';
    p.style.removeProperty('--caret-shift');
    if (!details.open) return;
    var overflow = p.getBoundingClientRect().right - window.innerWidth + 8;
    if (overflow > 0) {
      p.style.transform = 'translateX(-' + overflow + 'px)';
      p.style.setProperty('--caret-shift', overflow + 'px');
    }
  }
  var allNotes = document.querySelectorAll('.sched-venue-notes');
  allNotes.forEach(function (details) {
    details.addEventListener('toggle', function () { applyNotesOverflowShift(details); });
  });
  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      allNotes.forEach(function (details) {
        if (details.open) applyNotesOverflowShift(details);
      });
    }, 100);
  });

  // Field map lightbox — one shared overlay, populated from whichever
  // "Field map" link was clicked. Falls back to opening the image in a
  // new tab (the link's normal target="_blank" behavior) if the lightbox
  // markup isn't on the page for some reason.
  var lightbox = document.getElementById('fieldmap-lightbox');
  if (lightbox) {
    var lightboxImg = lightbox.querySelector('.fieldmap-lightbox-img');
    var openerEl = null;

    function openLightbox(href, opener) {
      lightboxImg.src = href;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      openerEl = opener || null;
      lightbox.querySelector('.fieldmap-lightbox-close').focus();
    }
    function closeLightbox() {
      lightbox.hidden = true;
      lightboxImg.src = '';
      document.body.style.overflow = '';
      if (openerEl) openerEl.focus();
    }

    document.querySelectorAll('.sched-day-fieldmap').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        openLightbox(link.href, link);
      });
    });
    lightbox.querySelector('.fieldmap-lightbox-backdrop').addEventListener('click', closeLightbox);
    lightbox.querySelector('.fieldmap-lightbox-close').addEventListener('click', closeLightbox);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });
  }
})();
</script>

<style>
  code { background: var(--surface-soft); padding: .15rem .4rem; border-radius: 6px; font-size: .85em; }
  .league-sched-section { padding: clamp(48px, 6vw, 80px) 0; }

  .season-complete-notice {
    display: flex; align-items: flex-start; gap: .85rem;
    padding: .85rem 1.1rem; margin-bottom: 1.25rem;
    background: #dcfce7; border: 1px solid #bbf7d0; border-radius: 14px; font-size: .9rem;
  }
  .season-complete-notice > span { font-size: 1.1rem; flex-shrink: 0; }
  .season-complete-notice strong { display: block; color: #15803d; font-weight: 700; margin-bottom: .1rem; }
  .season-complete-notice span   { color: #166534; }

  /* ── Filters ─────────────────────────────────── */
  .sched-filters {
    display: flex; flex-direction: column; gap: .75rem;
    margin-bottom: 1.75rem; padding: 1rem 1.25rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 18px;
  }
  .sched-filter-row   { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
  .sched-filter-label { font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); white-space: nowrap; min-width: 58px; }
  .sched-filter-tabs  { display: flex; gap: .35rem; flex-wrap: wrap; }

  .sched-tab {
    padding: .4rem .85rem; border-radius: 999px;
    border: 1px solid var(--line-strong); background: var(--surface);
    color: var(--muted); font-size: .82rem; font-weight: 600;
    cursor: pointer; white-space: nowrap;
    transition: background .15s, color .15s, border-color .15s;
  }
  .sched-tab:hover   { background: var(--surface-soft); color: var(--text); border-color: var(--text); }
  /* Active: solid filled — no opacity, full contrast */
  .sched-tab--active {
    background: var(--charcoal);
    color: #fff;
    border-color: var(--charcoal);
    font-weight: 700;
  }
  /* Past weeks: slightly muted text, still fully legible */
  .sched-tab--past {
    color: var(--soft);
    background: var(--surface-soft);
    border-color: var(--line-strong);
  }
  .sched-tab--past:hover { color: var(--text); background: var(--surface-soft); }

  /* ── Day panel ───────────────────────────────── */
  .sched-day--hidden { display: none; }
  .sched-day-hdr { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 1rem; margin-bottom: 1rem; border-bottom: 2px solid var(--line); }
  .sched-day-week { display: block; font-size: .68rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--rose-deep); margin-bottom: .2rem; }
  .week-status-past {
    display: inline-block; margin-left: .5rem;
    padding: .1rem .48rem; border-radius: 999px;
    background: var(--surface-soft); color: var(--soft);
    font-size: .62rem; font-weight: 700; letter-spacing: .06em;
    vertical-align: middle; border: 1px solid var(--line);
  }
  .sched-day-date  { margin: 0 0 .2rem; font-size: 1.3rem; font-weight: 800; color: var(--text); letter-spacing: -.02em; }
  /* One block per venue that day — almost always just one, but can be more
     when divisions are hosted at different parks the same day. */
  .sched-venue-group + .sched-venue-group { margin-top: 2rem; }
  .sched-day-venue-row { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-bottom: .3rem; }
  .sched-day-address { font-size: .82rem; color: var(--soft); margin-bottom: .85rem; }
  .sched-day-venue {
    font-size: .88rem;
    color: var(--rose-deep);
    font-weight: 600;
    text-decoration: none;
  }
  .sched-day-venue:hover { text-decoration: underline; }
  /* Filled/tinted, with an icon — deliberately a different treatment
     from the outlined "Notes" toggle next to it, so the two don't read
     as the same kind of control (one opens an image, the other reveals
     text inline). */
  .sched-day-fieldmap {
    display: inline-flex;
    align-items: center;
    gap: .32rem;
    font-size: .78rem;
    font-weight: 600;
    color: var(--rose-deep);
    text-decoration: none;
    background: var(--rose-bg);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: .15rem .7rem .15rem .55rem;
    transition: background .15s, border-color .15s;
  }
  .sched-day-fieldmap svg { width: 12px; height: 12px; flex-shrink: 0; }
  .sched-day-fieldmap:hover { background: var(--rose-deep); color: #fff; }
  /* Click-to-open, not a hover tooltip — shows for any venue note, not
     just ones that happen to sound like a warning. The revealed text is a
     floating popover anchored to the button (position:relative on the
     <details>, position:absolute on the <p>) rather than part of normal
     flex flow — the button's own position never changes between closed
     and open, only a small card appears near it. */
  .sched-venue-notes { position: relative; }
  .sched-venue-notes summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .78rem;
    font-weight: 600;
    color: var(--muted);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: .15rem .6rem .15rem .7rem;
    transition: color .15s, border-color .15s, background .15s;
  }
  .sched-venue-notes summary::-webkit-details-marker { display: none; }
  .sched-venue-notes summary::after {
    content: '';
    width: 5px; height: 5px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition: transform .15s;
  }
  .sched-venue-notes[open] summary::after { transform: rotate(-135deg) translateY(1px); }
  .sched-venue-notes summary:hover,
  .sched-venue-notes[open] summary {
    color: var(--rose-deep);
    border-color: var(--rose-deep);
    background: var(--rose-bg);
  }
  .sched-venue-notes p {
    position: absolute;
    top: calc(100% + .65rem);
    left: 0;
    z-index: 5;
    margin: 0;
    width: max-content;
    max-width: min(340px, calc(100vw - 2.5rem));
    padding: .7rem .9rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    font-size: .82rem;
    line-height: 1.55;
    color: var(--muted);
  }
  /* Caret pointing back up at the button, so the popover reads as
     anchored to it rather than a stray floating box. Shifted right by
     JS (via --caret-shift, clamped to the box's own width) whenever the
     box itself got nudged left to stay clear of the viewport edge — see
     the toggle listener below. */
  .sched-venue-notes p::before {
    content: '';
    position: absolute;
    top: -6px;
    left: min(calc(16px + var(--caret-shift, 0px)), calc(100% - 28px));
    width: 11px; height: 11px;
    background: var(--surface);
    border-left: 1px solid var(--line);
    border-top: 1px solid var(--line);
    transform: rotate(45deg);
  }

  /* ── Game list ───────────────────────────────── */
  .sched-list {
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
  }
  .sched-list-header,
  .sched-row {
    display: grid;
    grid-template-columns: 64px 110px 1fr 200px;
    align-items: center;
    gap: 0 1rem;
  }
  .sched-list-header {
    background: var(--surface-soft);
    border-bottom: 2px solid var(--line);
    padding: .6rem 1rem;
  }
  .sched-list-header span {
    font-size: .66rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--muted);
  }
  .sl-field-head { text-align: right; }
  .sched-row {
    padding: .78rem 1rem;
    border-bottom: 1px solid var(--line);
    transition: background .12s;
  }
  .sched-row:last-child { border-bottom: none; }
  .sched-row:hover { background: var(--surface-soft); }

  .sl-div  { display: flex; align-items: center; }
  .div-chip {
    display: inline-block; padding: .2rem .55rem; border-radius: 999px;
    font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    background: color-mix(in srgb, var(--olive) 10%, white);
    color: var(--olive);
    border: 1px solid color-mix(in srgb, var(--olive) 16%, white);
    white-space: nowrap;
  }

  .sl-time        { display: flex; flex-direction: column; gap: .1rem; }
  .sl-time strong { font-size: .9rem; color: var(--text); font-weight: 700; }
  .sl-arrive      { font-size: .74rem; color: var(--muted); }

  .sl-matchup { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
