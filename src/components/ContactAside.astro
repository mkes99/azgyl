---
// ContactAside — common topics panel shown beside the contact form.
// Pages use this as: <ContactAside />
import { socialLinks } from '@/data/site-meta';
const topics = [
  {
    title: 'Team registration',
    desc:  'Registration is handled by each member club directly — not AZGYL.',
    label: 'Find your team',
    href:  '/teams',
  },
  {
    title: 'Schedule & standings',
    desc:  'Full game schedule and division standings for the current season.',
    label: 'League page',
    href:  '/league',
  },
  {
    title: 'Rules & eligibility',
    desc:  'Player eligibility, rostering rules, and game-day standards.',
    label: 'Rules',
    href:  '/rules',
  },
  {
    title: 'Become an official',
    desc:  'Join the AZGYL officials program — paid assignments for certified refs. Fill out the interest form and the board will follow up.',
    label: 'Open the interest form',
    href:  'https://docs.google.com/forms/d/e/1FAIpQLSdy7a7feSTop8dhUs9vtMVerqo16ckG_VHTjhVkuA97wEBLMA/viewform',
    external: true,
  },
  {
    title: 'Follow along',
    desc:  'Game photos, schedule updates, and league news, posted first on Instagram.',
    label: 'Follow @arizonagirlsyouthlacrosse',
    href:  socialLinks.find(s => s.platform === 'instagram')?.href,
    external: true,
  },
];
---

<div class="section-header-clean">
  <div>
    <div class="section-kicker">Get in touch</div>
    <h2>Common topics</h2>
  </div>
  <div class="section-header-copy">
    <p>Quick links for the most common questions — reach out above if yours isn't here.</p>
  </div>
</div>
<div class="topics-grid">
  {topics.map(item => (
    <div class="info-panel">
      <strong>{item.title}</strong>
      <p>{item.desc}</p>
      <a
        class="button button-outline button-sm"
        href={item.href}
        style="margin-top:.75rem"
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noreferrer' : undefined}
      >
        {item.label}{item.external && <span class="sr-only"> (opens in a new tab)</span>}
      </a>
    </div>
  ))}
</div>
