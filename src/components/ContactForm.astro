---
// ContactForm — self-contained with Resend via Cloudflare Pages Function.
// HTML5 native validation is ON (no novalidate).
// Required fields marked with * — standard, universally understood.
// Optional fields have no marker — absence of * means optional.
import { teams } from '@/data/teams';
import { leagueInbox } from '@/data/board';

// Until a Google mailbox is set up for the Resend / Cloudflare function below,
// the form opens the visitor's email app addressed to the league inbox.
// Set to false to switch back to sending through /api/contact (the original
// fetch + reCAPTCHA code below is untouched).
const useMailto = true;

const departments = [
  'General Questions',
  'Registration & Team Signup',
  'Player Placement & Boundaries',
  'Rules & Eligibility',
  'Scheduling & Operations',
  'Coaching & Volunteers',
  'Officials',
  'Website & Communications',
];
---

<form id="contact-form" class="contact-form-inner">

  <div class="form-grid">
    <label>
      <span class="label-text">Name <span class="req" aria-hidden="true">*</span></span>
      <input
        name="name"
        type="text"
        placeholder="Your name"
        required
        autocomplete="name"
      />
    </label>
    <label>
      <span class="label-text">Email <span class="req" aria-hidden="true">*</span></span>
      <input
        name="email"
        type="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
      />
    </label>
  </div>

  <div class="form-grid">
    <label>
      Department
      <select name="department">
        {departments.map(d => <option value={d}>{d}</option>)}
      </select>
    </label>
    <label>
      Team or area
      <input
        name="team"
        type="text"
        placeholder={`e.g. ${teams[0]?.name ?? 'your team'}, your area`}
        list="contact-team-options"
        autocomplete="off"
      />
      <datalist id="contact-team-options">
        {teams.map(team => <option value={team.name} />)}
      </datalist>
    </label>
  </div>

  <input type="hidden" name="subject" id="contact-subject" />

  <label>
    <span class="label-text">Message <span class="req" aria-hidden="true">*</span></span>
    <textarea name="message" placeholder="How can we help?" required></textarea>
  </label>

  <p class="form-required-note" style="margin-top:.6rem"><span class="req">*</span> Required field</p>

  <div id="form-status" class="form-status" hidden></div>

  <div class="actions form-actions">
    <button class="button button-primary" type="submit" id="form-submit">
      {useMailto ? 'Email Us' : 'Send Message'}
    </button>
  </div>

  {useMailto ? (
    <p class="note">
      This opens your email app with your message ready to send to <a href={`mailto:${leagueInbox}`}>{leagueInbox}</a>.
    </p>
  ) : (
    <p class="note">
      This form sends directly to the AZGYL board via Resend. Protected by reCAPTCHA v3.
    </p>
  )}
</form>

<script is:inline define:vars={{ useMailto, inbox: leagueInbox }}>
(function () {
  var form   = document.getElementById('contact-form');
  var status = document.getElementById('form-status');
  var submit = document.getElementById('form-submit');

  if (!form) return;

  // Links elsewhere on the site can pre-set a topic: /contact?subject=Sponsorship
  var subjectField = document.getElementById('contact-subject');
  var presetSubject = new URLSearchParams(window.location.search).get('subject');
  if (presetSubject && subjectField) {
    subjectField.value = presetSubject;
    var heading = document.createElement('p');
    heading.className = 'form-required-note';
    heading.textContent = 'Regarding: ' + presetSubject;
    form.insertBefore(heading, form.firstChild);
  }

  function showStatus(msg, type) {
    status.textContent = msg;
    status.className   = 'form-status form-status--' + type;
    status.hidden      = false;
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();

    // HTML5 validation ran already (no novalidate) — if we're here it passed.

    // Mailto mode: hand the message to the visitor's email app instead of
    // posting to /api/contact. See `useMailto` in the frontmatter.
    if (useMailto) {
      var mailData = new FormData(form);
      var mailTeam = mailData.get('team');
      var mailBody = [
        mailData.get('message'),
        '',
        '— ' + mailData.get('name') + ' (' + mailData.get('email') + ')',
        mailTeam ? 'Team or area: ' + mailTeam : '',
      ].join('\n').trim();
      window.location.href = 'mailto:' + inbox +
        '?subject=' + encodeURIComponent(mailData.get('subject') || ('[' + mailData.get('department') + '] AZGYL website inquiry')) +
        '&body=' + encodeURIComponent(mailBody);
      showStatus('Opening your email app. If nothing opens, email us directly at ' + inbox + '.', 'success');
      return;
    }

    submit.disabled    = true;
    submit.textContent = 'Sending…';
    status.hidden      = true;

    var data = new FormData(form);
    var payload = {
      name:       data.get('name'),
      email:      data.get('email'),
      department: data.get('department'),
      team:       data.get('team'),
      message:    (data.get('subject') ? 'Regarding: ' + data.get('subject') + '\n\n' : '') + data.get('message'),
      recaptchaToken: null,
    };

    // reCAPTCHA v3 — only if site key meta tag is present
    var metaKey = document.querySelector('meta[name="recaptcha-site-key"]');
    if (metaKey && window.grecaptcha) {
      try {
        payload.recaptchaToken = await new Promise(function (resolve, reject) {
          window.grecaptcha.ready(function () {
            window.grecaptcha.execute(metaKey.content, { action: 'contact' }).then(resolve).catch(reject);
          });
        });
      } catch (_) { /* continue without token */ }
    }

    try {
      var res  = await fetch('/api/contact', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(payload),
      });
      var json = await res.json();
      if (json.ok) {
        showStatus("Message sent! We'll be in touch within 1–2 business days.", 'success');
        form.reset();
      } else {
        showStatus(json.error || 'Something went wrong. Please try again.', 'error');
      }
    } catch (_) {
      showStatus('Network error. Please check your connection and try again.', 'error');
    }

    submit.disabled    = false;
    submit.textContent = 'Send Message';
  });
})();
</script>

<style>
  .contact-form-inner {
    display: grid;
    gap: 1.1rem;
  }

  /* label-text keeps the label + asterisk on one line
     even when <label> is display:grid from global CSS */
  .label-text {
    display: inline;
  }
  .req {
    color: var(--olive);
    font-weight: 700;
    margin-left: .15rem;
  }
  .form-required-note {
    font-size: .78rem;
    color: var(--soft);
    margin: -.25rem 0 0;
    display: flex;
    align-items: center;
    gap: .2rem;
  }
  .form-required-note .req {
    margin-left: 0;
  }
  .form-status {
    padding: .85rem 1.1rem;
    border-radius: 14px;
    font-size: .92rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .form-status--success {
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
  .form-status--error {
    background: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }
</style>
