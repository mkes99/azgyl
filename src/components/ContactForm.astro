---
// ContactForm — self-contained with Resend via Cloudflare Pages Function.
// HTML5 native validation is ON (no novalidate).
// Required fields marked with * — standard, universally understood.
// Optional fields have no marker — absence of * means optional.
const departments = [
  'General Questions',
  'Registration & Team Signup',
  'Player Placement & Boundaries',
  'Rules & Eligibility',
  'Scheduling & Operations',
  'Coaching & Volunteers',
  'Officials',
  'Website & Communications',
];
---

<form id="contact-form" class="contact-form-inner">

  <div class="form-grid">
    <label>
      <span class="label-text">Name <span class="req" aria-hidden="true">*</span></span>
      <input
        name="name"
        type="text"
        placeholder="Your name"
        required
        autocomplete="name"
      />
    </label>
    <label>
      <span class="label-text">Email <span class="req" aria-hidden="true">*</span></span>
      <input
        name="email"
        type="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
      />
    </label>
  </div>

  <div class="form-grid">
    <label>
      Department
      <select name="department">
        {departments.map(d => <option value={d}>{d}</option>)}
      </select>
    </label>
    <label>
      Team or area
      <input
        name="team"
        type="text"
        placeholder="e.g. Diamonds, Tucson area"
        autocomplete="off"
      />
    </label>
  </div>

  <label>
    <span class="label-text">Message <span class="req" aria-hidden="true">*</span></span>
    <textarea name="message" placeholder="How can we help?" required></textarea>
  </label>

  <p class="form-required-note" style="margin-top:.6rem"><span class="req">*</span> Required field</p>

  <div id="form-status" class="form-status" hidden></div>

  <div class="actions form-actions">
    <button class="button button-primary" type="submit" id="form-submit">
      Send Message
    </button>
  </div>

  <p class="note">
    This form sends directly to the AZGYL board via Resend. Protected by reCAPTCHA v3.
  </p>
</form>

<script is:inline>
(function () {
  var form   = document.getElementById('contact-form');
  var status = document.getElementById('form-status');
  var submit = document.getElementById('form-submit');

  if (!form) return;

  function showStatus(msg, type) {
    status.textContent = msg;
    status.className   = 'form-status form-status--' + type;
    status.hidden      = false;
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();

    // HTML5 validation ran already (no novalidate) — if we're here it passed.
    submit.disabled    = true;
    submit.textContent = 'Sending…';
    status.hidden      = true;

    var data = new FormData(form);
    var payload = {
      name:       data.get('name'),
      email:      data.get('email'),
      department: data.get('department'),
      team:       data.get('team'),
      message:    data.get('message'),
      recaptchaToken: null,
    };

    // reCAPTCHA v3 — only if site key meta tag is present
    var metaKey = document.querySelector('meta[name="recaptcha-site-key"]');
    if (metaKey && window.grecaptcha) {
      try {
        payload.recaptchaToken = await new Promise(function (resolve, reject) {
          window.grecaptcha.ready(function () {
            window.grecaptcha.execute(metaKey.content, { action: 'contact' }).then(resolve).catch(reject);
          });
        });
      } catch (_) { /* continue without token */ }
    }

    try {
      var res  = await fetch('/api/contact', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(payload),
      });
      var json = await res.json();
      if (json.ok) {
        showStatus("Message sent! We'll be in touch within 1–2 business days.", 'success');
        form.reset();
      } else {
        showStatus(json.error || 'Something went wrong. Please try again.', 'error');
      }
    } catch (_) {
      showStatus('Network error. Please check your connection and try again.', 'error');
    }

    submit.disabled    = false;
    submit.textContent = 'Send Message';
  });
})();
</script>

<style>
  .contact-form-inner {
    display: grid;
    gap: 1.1rem;
  }

  /* label-text keeps the label + asterisk on one line
     even when <label> is display:grid from global CSS */
  .label-text {
    display: inline;
  }
  .req {
    color: var(--olive);
    font-weight: 700;
    margin-left: .15rem;
  }
  .form-required-note {
    font-size: .78rem;
    color: var(--soft);
    margin: -.25rem 0 0;
    display: flex;
    align-items: center;
    gap: .2rem;
  }
  .form-required-note .req {
    margin-left: 0;
  }
  .form-status {
    padding: .85rem 1.1rem;
    border-radius: 14px;
    font-size: .92rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .form-status--success {
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
  .form-status--error {
    background: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }
</style>
