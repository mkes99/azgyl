---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="faq-stack">
  {items.map((item, index) => (
    <details class="faq-item" open={index === 0}>
      <summary>
        <span>{item.q}</span>
      </summary>
      <div class="faq-body"><p>{item.a}</p></div>
    </details>
  ))}
</div>
