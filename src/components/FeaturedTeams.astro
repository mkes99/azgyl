---
import TeamCard from '@/components/TeamCard.astro';
import { teams } from '@/data/teams';
import SectionIntro from '@/components/SectionIntro.astro';

interface Props {
  limit?: number;
  eyebrow?: string;
  title?: string;
  intro?: string;
  href?: string;
}

const { limit = 6, eyebrow = 'Current programs', title = 'Start with a team that already exists.', intro = 'Show the current directory cleanly. Regions matter when they connect to a real team option — not as filler navigation.', href = '/teams' } = Astro.props;
const featuredTeams = teams.slice(0, limit);
---
<div class="container directory-head">
  <SectionIntro eyebrow={eyebrow} title={title} intro={intro} />
  <div class="directory-cta-wrap"><a class="button button-outline" href={href}>View full directory</a></div>
</div>
<div class="container team-grid">
  {featuredTeams.map((team) => <TeamCard team={team} compact />)}
</div>
