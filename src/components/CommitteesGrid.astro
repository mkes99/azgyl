---
interface CommitteeLink { label: string; href: string }
interface Committee { title: string; body: string; links?: CommitteeLink[] }
interface Props { items: Committee[] }
const { items } = Astro.props;
---
<div class="leadership-grid">
  {items.map((item) => (
    <article class="leadership-card">
      <h3>{item.title}</h3>
      <p>{item.body}</p>
      {item.links && item.links.length > 0 && (
        <div class="inline-chips">
          {item.links.map((link) => <a class="inline-chip" href={link.href}>{link.label}</a>)}
        </div>
      )}
    </article>
  ))}
</div>
