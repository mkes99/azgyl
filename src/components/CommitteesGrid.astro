---
// CommitteesGrid — renders standing committees.
// Pages use this as: <CommitteesGrid />
import { committees } from '@/data/committees';
---

<div class="leadership-grid">
  {committees.map(item => (
    <article class="leadership-card">
      <h3>{item.title}</h3>
      <p>{item.body}</p>
      {item.links && item.links.length > 0 && (
        <div class="inline-chips" style="margin-top:.75rem">
          {item.links.map(link => (
            <a class="inline-chip" href={link.href}>{link.label}</a>
          ))}
        </div>
      )}
    </article>
  ))}
</div>
