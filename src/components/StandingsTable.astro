---
// StandingsTable
// Data lives in src/data/standings.ts
// Renders standings for one event + division.
// Responsive: table on desktop, stacked cards on mobile.
import { allStandings, sortedRows } from '@/data/standings';

interface Props {
  eventId?:  string;   // omit = first entry in allStandings
  division?: string;   // omit = show all divisions for that event
}
const { eventId, division } = Astro.props;

const event  = eventId
  ? allStandings.find(s => s.eventId === eventId)
  : allStandings[0];

const divs = event
  ? (division ? event.divisions.filter(d => d.division === division) : event.divisions)
  : [];
---

{divs.map(div => {
  const rows = sortedRows(div.rows);
  return (
    <div class="standings-wrap">
      <div class="standings-div-label">{div.division}</div>

      {/* ── Desktop table ──────────────────────── */}
      <div class="standings-table-shell">
        <table class="standings-table" aria-label={`${div.division} standings`}>
          <thead>
            <tr>
              <th style="width:36px">#</th>
              <th>Team</th>
              <th title="Wins">W</th>
              <th title="Losses">L</th>
              <th title="Ties">T</th>
              <th title="Points">Pts</th>
              <th title="Goals For">GF</th>
              <th title="Goals Against">GA</th>
              <th title="Goal Differential">+/−</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => {
              const pts  = row.W * 3 + row.T;
              const diff = row.GF - row.GA;
              return (
                <tr class={i === 0 ? 'row-leader' : ''}>
                  <td>
                    {i === 0
                      ? <span class="rank-badge">1</span>
                      : <span class="rank-num">{i + 1}</span>}
                  </td>
                  <td class="col-team-name">
                    {i === 0 && <span class="leader-pip" aria-hidden="true"></span>}
                    {row.team}
                  </td>
                  <td class="col-stat"><strong>{row.W}</strong></td>
                  <td class="col-stat">{row.L}</td>
                  <td class="col-stat">{row.T}</td>
                  <td class="col-pts"><strong>{pts}</strong></td>
                  <td class="col-stat">{row.GF}</td>
                  <td class="col-stat">{row.GA}</td>
                  <td class={`col-diff${diff > 0 ? ' diff-pos' : diff < 0 ? ' diff-neg' : ''}`}>
                    {diff > 0 ? `+${diff}` : diff}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {/* ── Mobile cards ───────────────────────── */}
      <div class="standings-cards">
        {rows.map((row, i) => {
          const pts  = row.W * 3 + row.T;
          const diff = row.GF - row.GA;
          return (
            <div class={`stand-card${i === 0 ? ' stand-card--leader' : ''}`}>
              <div class="stand-left">
                <span class="stand-rank">{i === 0 ? '🥇' : i + 1}</span>
                <span class="stand-team">{row.team}</span>
              </div>
              <div class="stand-stats">
                <div class="stand-stat"><span>W</span><strong>{row.W}</strong></div>
                <div class="stand-stat"><span>L</span><strong>{row.L}</strong></div>
                <div class="stand-stat"><span>T</span><strong>{row.T}</strong></div>
                <div class="stand-stat"><span>Pts</span><strong>{pts}</strong></div>
                <div class={`stand-stat${diff > 0 ? ' diff-pos' : diff < 0 ? ' diff-neg' : ''}`}>
                  <span>+/−</span><strong>{diff > 0 ? `+${diff}` : diff}</strong>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
})}

<style>
  .standings-wrap { display: grid; gap: .65rem; margin-bottom: 1.75rem; }
  .standings-wrap:last-child { margin-bottom: 0; }
  .standings-div-label { font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--cyan-deep); }

  /* ── Desktop ─────────────────────────────────── */
  .standings-table-shell { border-radius: 18px; border: 1px solid var(--line); background: var(--surface); overflow: hidden; }
  .standings-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .standings-table thead tr { background: var(--surface-soft); border-bottom: 2px solid var(--line); }
  .standings-table th { padding: .65rem 1rem; text-align: left; font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .standings-table td { padding: .72rem 1rem; border-bottom: 1px solid var(--line); }
  .standings-table tbody tr:last-child td { border-bottom: none; }
  .row-leader td { background: color-mix(in srgb, var(--cyan) 6%, white); }

  .rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(135deg, var(--cyan), var(--purple)); color: #fff; font-size: .72rem; font-weight: 800; }
  .rank-num   { color: var(--soft); font-size: .85rem; }
  .col-team-name { display: flex; align-items: center; gap: .5rem; font-weight: 700; color: var(--text); }
  .leader-pip { width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); flex-shrink: 0; }
  .col-stat   { color: var(--muted); text-align: center; }
  .col-stat strong { color: var(--text); }
  .col-pts    { color: var(--purple-deep); font-weight: 700; text-align: center; }
  .col-diff   { text-align: center; }
  .diff-pos   { color: #15803d; font-weight: 700; }
  .diff-neg   { color: #b91c1c; }

  /* ── Mobile cards ────────────────────────────── */
  .standings-cards { display: none; flex-direction: column; gap: .45rem; }
  .stand-card { border-radius: 16px; border: 1px solid var(--line); background: var(--surface); padding: .85rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .stand-card--leader { background: color-mix(in srgb, var(--cyan) 6%, white); border-color: color-mix(in srgb, var(--cyan) 22%, white); }
  .stand-left { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .stand-rank { font-size: .88rem; font-weight: 800; color: var(--soft); flex-shrink: 0; min-width: 20px; }
  .stand-team { font-weight: 700; color: var(--text); font-size: .9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stand-stats { display: flex; gap: .85rem; align-items: center; flex-shrink: 0; }
  .stand-stat { display: flex; flex-direction: column; align-items: center; gap: .1rem; }
  .stand-stat span { font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); }
  .stand-stat strong { font-size: .92rem; color: var(--text); }
  .stand-stat.diff-pos strong { color: #15803d; }
  .stand-stat.diff-neg strong { color: #b91c1c; }

  @media (max-width: 600px) {
    .standings-table-shell { display: none; }
    .standings-cards { display: flex; }
  }
</style>
