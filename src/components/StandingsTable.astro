---
// StandingsTable
// `standings` is already fully resolved by src/data/standings.ts (fetched
// + validated from the Sheet if STANDINGS_CSV_URL is set, localStandings
// otherwise) — this component just picks which event/division to render.
// Responsive: table on desktop, stacked cards on mobile.
import { standings, sortedRows } from '@/data/standings';

interface Props {
  eventId?:  string;
  division?: string;
}
const { eventId, division } = Astro.props;

const event = eventId
  ? standings.find(s => s.eventId === eventId)
  : standings[0];

const divs = event
  ? (division ? event.divisions.filter(d => d.division === division) : event.divisions)
  : [];
---

{divs.length > 0 && (
  <p class="standings-legend">
    <strong>W</strong> Wins · <strong>L</strong> Losses · <strong>T</strong> Ties ·
    <strong> Pts</strong> Points · <strong>GF</strong> Goals For · <strong>GA</strong> Goals Against ·
    <strong> +/−</strong> Goal differential (used to break ties in points)
  </p>
)}

{divs.map(div => {
  const rows = sortedRows(div.rows);
  return (
    <div class="standings-wrap">
      <div class="standings-div-label">{div.division}</div>

      {/* Desktop table */}
      <div class="standings-table-shell">
        <table class="standings-table" aria-label={`${div.division} standings`}>
          <colgroup>
            <col style="width:52px"  />
            <col />
            <col style="width:54px"  />
            <col style="width:54px"  />
            <col style="width:54px"  />
            <col style="width:62px"  />
            <col style="width:54px"  />
            <col style="width:54px"  />
            <col style="width:62px"  />
          </colgroup>
          <thead>
            <tr>
              <th class="th-rank">#</th>
              <th class="th-team">Team</th>
              <th class="th-num" title="Wins">W</th>
              <th class="th-num" title="Losses">L</th>
              <th class="th-num" title="Ties">T</th>
              <th class="th-num th-pts" title="Points">Pts</th>
              <th class="th-num" title="Goals For">GF</th>
              <th class="th-num" title="Goals Against">GA</th>
              <th class="th-num" title="Goal Differential">+/−</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => {
              const pts  = row.wins * 3 + row.ties;
              const diff = row.goalsFor - row.goalsAgainst;
              return (
                <tr class={i === 0 ? 'row-leader' : ''}>
                  <td class="td-rank">
                    {i === 0
                      ? <span class="rank-badge">1</span>
                      : <span class="rank-num">{i + 1}</span>}
                  </td>
                  <td class="td-team">
                    <span class="td-team-inner">
                      {i === 0 && <span class="leader-pip" aria-hidden="true" />}
                      {row.team}
                    </span>
                  </td>
                  <td class="td-num">{row.wins}</td>
                  <td class="td-num td-muted">{row.losses}</td>
                  <td class="td-num td-muted">{row.ties}</td>
                  <td class="td-num td-pts">{pts}</td>
                  <td class="td-num td-muted">{row.goalsFor}</td>
                  <td class="td-num td-muted">{row.goalsAgainst}</td>
                  <td class={`td-num${diff > 0 ? ' td-pos' : diff < 0 ? ' td-neg' : ' td-muted'}`}>
                    {diff > 0 ? `+${diff}` : diff}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {/* Mobile cards */}
      <div class="standings-cards">
        {rows.map((row, i) => {
          const pts  = row.wins * 3 + row.ties;
          const diff = row.goalsFor - row.goalsAgainst;
          return (
            <div class={`stand-card${i === 0 ? ' stand-card--leader' : ''}`}>
              <div class="stand-left">
                {i === 0
                  ? <span class="rank-badge">1</span>
                  : <span class="rank-num">{i + 1}</span>}
                <span class="stand-team">{row.team}</span>
              </div>
              <div class="stand-stats">
                <div class="stand-stat"><span>W</span><strong>{row.wins}</strong></div>
                <div class="stand-stat"><span>L</span><strong>{row.losses}</strong></div>
                <div class="stand-stat"><span>T</span><strong>{row.ties}</strong></div>
                <div class="stand-stat stand-stat--pts"><span>Pts</span><strong>{pts}</strong></div>
                <div class={`stand-stat${diff > 0 ? ' stand-stat--pos' : diff < 0 ? ' stand-stat--neg' : ''}`}>
                  <span>+/−</span><strong>{diff > 0 ? `+${diff}` : diff}</strong>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
})}

<style>
  .standings-wrap { display: grid; gap: .65rem; margin-bottom: 2rem; }
  .standings-wrap:last-child { margin-bottom: 0; }
  .standings-div-label { font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--rose-deep); }

  .standings-table-shell { border-radius: 18px; border: 1px solid var(--line); background: var(--surface); overflow: hidden; }
  .standings-table { width: 100%; border-collapse: collapse; font-size: .9rem; table-layout: fixed; }
  .standings-table thead tr { background: var(--surface-soft); border-bottom: 2px solid var(--line); }
  .standings-table th { padding: .65rem 1rem; font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .th-rank { text-align: center; }
  .th-team { text-align: left; }
  .th-num  { text-align: center; }
  .th-pts  { color: var(--olive); }
  .standings-table td { padding: .78rem 1rem; border-bottom: 1px solid var(--line); }
  .standings-table tbody tr:last-child td { border-bottom: none; }
  .standings-table tbody tr:hover td { background: var(--surface-soft); }
  .row-leader td { background: color-mix(in srgb, var(--rose) 5%, white); }

  .td-rank { text-align: center; }
  .rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: linear-gradient(135deg, var(--rose-deep), var(--olive)); color: #fff; font-size: .72rem; font-weight: 800; }
  .rank-num  { color: var(--soft); font-size: .88rem; }

  .td-team { font-weight: 700; color: var(--text); }
  .td-team-inner { display: inline-flex; align-items: center; gap: .5rem; }
  .leader-pip { width: 6px; height: 6px; border-radius: 50%; background: var(--rose); flex-shrink: 0; }

  .td-num   { text-align: center; color: var(--text); }
  .td-muted { color: var(--muted); }
  .td-pts   { color: var(--olive); font-weight: 700; }
  .td-pos   { color: #15803d; font-weight: 700; }
  .td-neg   { color: #b91c1c; }

  .standings-cards { display: none; flex-direction: column; gap: .45rem; }
  .stand-card { border-radius: 16px; border: 1px solid var(--line); background: var(--surface); padding: .85rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .stand-card--leader { background: color-mix(in srgb, var(--rose) 5%, white); border-color: color-mix(in srgb, var(--rose) 20%, white); }
  .stand-left  { display: flex; align-items: center; gap: .65rem; min-width: 0; }
  .stand-team  { font-weight: 700; color: var(--text); font-size: .9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stand-stats { display: flex; gap: .85rem; align-items: center; flex-shrink: 0; }
  .stand-stat         { display: flex; flex-direction: column; align-items: center; gap: .1rem; }
  .stand-stat span    { font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); }
  .stand-stat strong  { font-size: .92rem; color: var(--text); }
  .stand-stat--pts strong { color: var(--olive); font-weight: 700; }
  .stand-stat--pos strong { color: #15803d; }
  .stand-stat--neg strong { color: #b91c1c; }

  .standings-legend { margin: 0 0 2.1rem; font-size: .78rem; color: var(--muted); line-height: 1.6; }
  .standings-legend strong { color: var(--soft); font-weight: 700; }

  @media (max-width: 600px) {
    .standings-table-shell { display: none; }
    .standings-cards { display: flex; }
  }
</style>
