---
import { primaryNav, parentNav, resourceNav } from '@/data/site-meta';
const { pathname = '/' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Arizona Girls Youth Lacrosse home">
      <img src="/assets/brand/logo-transparent.png" alt="Arizona Girls Youth Lacrosse" />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <details class="nav-group">
        <summary class:list={{ active: isActive('/parents') || isActive('/teams') }}>
          Parents
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="nav-dropdown">
          {parentNav.map(item => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
      <a href="/league"     class:list={{ active: isActive('/league') }}>League</a>
      <a href="/leadership" class:list={{ active: isActive('/leadership') }}>Leadership</a>
      <details class="nav-group">
        <summary class:list={{ active: isActive('/resources') || isActive('/rules') || isActive('/boundaries') }}>
          Resources
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="nav-dropdown">
          {resourceNav.map(item => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
      <a href="/contact"    class:list={{ active: isActive('/contact') }}>Contact</a>
    </nav>

    <div class="header-actions">
      <a class="button button-primary button-sm" href="/teams">Find My Team</a>
      <button
        class="menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <div class="container mobile-menu-inner">
      <details class="mobile-group">
        <summary>Parents</summary>
        <div class="mobile-subnav">
          {parentNav.map(item => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
      <a href="/league">League</a>
      <a href="/leadership">Leadership</a>
      <details class="mobile-group">
        <summary>Resources</summary>
        <div class="mobile-subnav">
          {resourceNav.map(item => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
      <a href="/contact">Contact</a>
      <a class="button button-primary mobile-cta" href="/teams">Find My Team</a>
    </div>
  </div>
</header>
