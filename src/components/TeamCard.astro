---
interface Props {
  team: {
    name: string;
    notes?: string;
    city: string;
    district?: string;
    area?: string;
    divisions: string[];
    zipcode?: string[];
    contact?: string[];
    href: string;
    logo?: string;
    color?: string;
  };
  compact?: boolean;
}
const { team, compact = false } = Astro.props;
---
<article class:list={['team-card', compact && 'compact']} style={`--team-color:${team.color || '#6e58ff'}`} data-team-card data-name={team.name} data-area={team.area || ''} data-city={team.city} data-district={team.district} data-zips={team.zipcode?.join(',') || ''} data-divisions={team.divisions.join(',')}>
  <div class="team-brandline">
    {team.logo && <img class="team-logo" src={team.logo} alt="" loading="lazy" />}
    <div>
      <h3>{team.name}</h3>
      <div class="team-meta">{team.district ? `${team.city} · ${team.district}` : team.city}</div>
    </div>
  </div>
  {team.notes && <p>{team.notes}</p>}
  {!compact && <div class="team-meta soft">{team.divisions.join(' · ')}</div>}
  {team.contact?.length && (
    <div class="team-meta soft team-contact">
      <svg class="team-contact-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      <span>{team.contact.map((email, index) => (<>{index > 0 && ' · '}<a href={`mailto:${email}`}>{email}</a></>))}</span>
    </div>
  )}
  <div class="team-actions">
    <a class="button button-outline button-sm" href={team.href} target="_blank" rel="noreferrer">View program</a>
  </div>
</article>
