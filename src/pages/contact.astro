---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.astro';
import ContactAside from '@/components/ContactAside.astro';
---

<BaseLayout title="Contact the Board | AZGYL — Arizona Girls Youth Lacrosse" pathname="/contact">
  <PageHero
    eyebrow="Contact"
    title="Reach the AZGYL board."
    intro="Board inquiries, official assignment requests, new team applications, and general league questions. We respond within 1–2 business days."
    image="/assets/heroes/contact-hero.jpg"
  />

  <section>
    <div class="container contact-layout">
      <div class="contact-form-column">
        <ContactForm />
      </div>
      <div class="contact-aside">
        <ContactAside />
      </div>
    </div>
  </section>
</BaseLayout>
