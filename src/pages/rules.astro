---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import RuleSummary from '@/components/RuleSummary.astro';
import { ruleFaqs } from '@/data/rule-faqs';
---
<BaseLayout title="Rules | AZGYL" pathname="/rules">
  <PageHero eyebrow="Rules" title="USA Lacrosse foundation. AZGYL layer on top." intro="Gameplay and equipment standards come from USA Lacrosse. AZGYL publishes the Arizona rec layer clearly: placement, rosters, scheduling, conduct, game-day expectations, and how league decisions are handled." image="/assets/heroes/resources-hero.svg" />

  <section>
    <div class="container two-col split-balanced">
      <div class="copy stack-md">
        <div class="section-kicker">Start with the foundation</div>
        <h2 class="section-heading">Official gameplay comes from USA Lacrosse.</h2>
        <p>Use the national rulebook and equipment pages for the official standards. Then keep the Arizona rec layer here so parents and coaches do not have to decode multiple sites.</p>
        <div class="actions"><a class="button button-primary" href="https://www.usalacrosse.com/sites/default/files/documents/Rules/2026-Girls-Youth-Rule-Book.pdf" target="_blank" rel="noreferrer">2026 Youth Rule Book</a><a class="button button-outline" href="https://www.usalacrosse.com/equipment" target="_blank" rel="noreferrer">Equipment basics</a></div>
      </div>
      <RuleSummary />
    </div>
  </section>

  <section class="section-alt" id="conduct">
    <div class="container">
      <div class="copy stack-md" style="margin-bottom:1.5rem">
        <div class="section-kicker">Readable rules</div>
        <h2 class="section-heading">Publish the practical version, not just the PDF.</h2>
      </div>
      <FaqAccordion items={ruleFaqs} />
    </div>
  </section>
</BaseLayout>
