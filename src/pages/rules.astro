---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
---

<BaseLayout title="League Rules & Bylaws | AZGYL — Arizona Girls Youth Lacrosse" pathname="/rules">
  <PageHero
    eyebrow="Rules"
    title="How the AZGYL league works."
    intro="USA Lacrosse governs the sport itself. AZGYL adds the Arizona operating layer: eligibility, scheduling, conduct, and game-day responsibilities."
    image="/assets/heroes/rules-hero.jpg"
  />

  <section>
    <div class="container">
      <div class="info-panel">
        <div class="section-kicker">Rules</div>
        <h3>Coming soon</h3>
        <p>The AZGYL rules and bylaws are being finalized and will be posted here before the season. In the meantime, the <a href="https://www.usalacrosse.com/sites/default/files/documents/Rules/2026-Girls-Youth-Rule-Book.pdf" target="_blank" rel="noreferrer">2026 USA Lacrosse Rule Book (PDF)</a> governs play, and questions can go through the <a href="/contact">contact page</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
