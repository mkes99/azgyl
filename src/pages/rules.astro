---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { site } from '../data/site';

const ruleFaqs = [
  { q: 'Eligibility, USA Lacrosse membership, and Code of Conduct', a: 'League participation is limited to girls in grades K–8. Players, coaches, and officials all need current USA Lacrosse membership before participating, and Code of Conduct documentation must be completed before regular-season play.' },
  { q: 'Placement, boundaries, transfers, and the no-recruitment rule', a: 'Starting with 2026 entrants, school-affiliated placement is the base rule. If a school does not have an affiliated team, placement falls to the closest eligible team to the player home domicile. Transfers and hardships should be reviewed formally, and recruiting players for competitive advantage is off-limits.' },
  { q: 'Rosters, divisions, and flex rules', a: 'Players are rostered in 8U, 10U, 12U, or 14U. One roster per player is the default. Goalie flexibility and limited flex rostering exist to keep games playable, but the rule is not supposed to become a backdoor for stacking teams.' },
  { q: 'Scheduling, practices, and game changes', a: 'Preseason practices may begin in the fall but cannot be mandatory. Competition begins after the MLK weekend structure in the bylaws, and all teams should play the same number of divisional games. Schedule changes must be communicated early enough to keep officials and opponents aligned.' },
  { q: 'Game-day operations, medical, and reporting', a: 'Home teams provide the lined field, clock or scoreboard, water, ice, safety sheet, and timekeeper support. Both teams bring rosters, first aid, and proof of USA Lacrosse membership. Severe injuries need to be reported promptly and game summaries should be filed after play.' },
];
---

<BaseLayout title="Rules | AZGYL" pathname="/rules">
  <PageHero eyebrow="Rules" title="USA Lacrosse foundation. AZGYL layer on top." intro="Gameplay and equipment standards come from USA Lacrosse. AZGYL publishes the Arizona rec layer clearly: placement, rosters, scheduling, conduct, game-day expectations, and how league decisions are handled." image="/assets/heroes/resources-hero.svg" pills={['USA Lacrosse base', 'AZGYL rules', 'Eligibility', 'Game-day standards']} />

  <section>
    <div class="container two-col split-balanced">
      <div class="copy stack-md">
        <div class="section-kicker">Start with the foundation</div>
        <h2 class="section-heading">Official gameplay comes from USA Lacrosse.</h2>
        <p>Use the national rulebook and equipment pages for the official standards. Then keep the Arizona rec layer here so parents and coaches do not have to decode multiple sites.</p>
        <div class="actions"><a class="button button-primary" href="https://www.usalacrosse.com/sites/default/files/documents/Rules/2026-Girls-Youth-Rule-Book.pdf" target="_blank" rel="noreferrer">2026 Youth Rule Book</a><a class="button button-outline" href="https://www.usalacrosse.com/equipment" target="_blank" rel="noreferrer">Equipment basics</a></div>
      </div>
      <div class="rule-table">
        <div class="section-kicker">AZGYL layer</div>
        <h3>What the league owns directly</h3>
        {site.rulesSummary.map((item) => <div class="rule-row"><strong>{item.title}</strong><span>{item.body}</span></div>)}
      </div>
    </div>
  </section>

  <section class="section-alt" id="conduct">
    <div class="container">
      <div class="copy stack-md" style="margin-bottom:1.5rem">
        <div class="section-kicker">Readable rules</div>
        <h2 class="section-heading">Publish the practical version, not just the PDF.</h2>
      </div>
      <FaqAccordion items={ruleFaqs} />
    </div>
  </section>
</BaseLayout>
