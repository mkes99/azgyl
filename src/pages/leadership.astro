---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import LeadershipGrid from '@/components/LeadershipGrid.astro';
import CommitteesGrid from '@/components/CommitteesGrid.astro';
---
<BaseLayout title="Leadership | AZGYL" pathname="/leadership">
  <PageHero eyebrow="Leadership" title="Board leadership and committees should be easy to understand." intro="Keep leadership visible, practical, and parent-readable. These sections should explain who owns what without turning into internal jargon." image="/assets/heroes/resources-hero.svg" />

  <section>
    <div class="container stack-lg">
      <div class="section-header-clean">
        <div>
          <div class="section-kicker">Executive board</div>
          <h2>Executive Board</h2>
        </div>
        <div class="section-header-copy"><p>Replace placeholders with real names as soon as leadership is finalized. The layout already supports any number of board members.</p></div>
      </div>
      <LeadershipGrid />
    </div>
  </section>

  <section class="section-alt">
    <div class="container stack-lg">
      <div class="section-header-clean">
        <div>
          <div class="section-kicker">Committees</div>
          <h2>League Committees</h2>
        </div>
        <div class="section-header-copy"><p>Committees should map to actual league work. Each card supports direct links and can be extended with contact details as the structure is finalized.</p></div>
      </div>
      <CommitteesGrid />
    </div>
  </section>
</BaseLayout>
