---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import LeadershipGrid from '@/components/LeadershipGrid.astro';
import CommitteesGrid from '@/components/CommitteesGrid.astro';
import { board } from '@/data/board';
import { committees } from '@/data/committees';
---

<BaseLayout title="Leadership | AZGYL" pathname="/leadership">
  <PageHero
    eyebrow="Leadership"
    title="Board of directors and standing committees."
    intro="AZGYL is governed by a volunteer board of directors. All board members serve 2-year terms and are elected annually by member team representatives."
    image="/assets/heroes/regions-hero.svg"
  />

  <section>
    <div class="container">
      <div class="section-header-clean" style="margin-bottom:2rem">
        <div>
          <div class="section-kicker">Governance</div>
          <h2>Board of directors</h2>
        </div>
        <div class="section-header-copy">
          <p>Volunteer board members who set policy, approve budgets, and make binding decisions on behalf of AZGYL.</p>
        </div>
      </div>
      <LeadershipGrid members={board} />
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <div class="section-header-clean" style="margin-bottom:2rem">
        <div>
          <div class="section-kicker">Committees</div>
          <h2>Standing committees</h2>
        </div>
        <div class="section-header-copy">
          <p>League work is organized through standing committees — each chaired by a board member.</p>
        </div>
      </div>
      <CommitteesGrid items={committees} />
    </div>
  </section>

  <section>
    <div class="container two-col split-balanced">
      <div class="copy">
        <div class="section-kicker">Get involved</div>
        <h2 class="section-heading">Volunteer-run. Community-driven.</h2>
        <p>AZGYL runs entirely on volunteer effort. If you're a coach, parent, or lacrosse professional who wants to help build the league, we want to hear from you.</p>
        <div class="actions" style="margin-top:1rem">
          <a class="button button-primary" href="/contact">Get in touch</a>
        </div>
      </div>
      <div class="info-panel">
        <div class="section-kicker">Sponsors & partners</div>
        <h3>Support Arizona girls lacrosse</h3>
        <p>Sponsorships fund scholarships, equipment programs, and field access for Arizona girls. Presenting, Gold, and Silver sponsorship tiers available.</p>
        <div class="subpage-links" style="margin-top:1rem">
          <a href="/contact?subject=Sponsorship">Become a sponsor →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
