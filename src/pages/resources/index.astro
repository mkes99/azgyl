---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ResourceCards from '@/components/ResourceCards.astro';
---
<BaseLayout title="Resources | AZGYL" pathname="/resources">
  <PageHero eyebrow="Resources" title="Rules, boundaries, and the practical league tools that should live in one place." intro="AZGYL should own the Arizona layer clearly: team directory, eligibility, boundaries, age groups, conduct, and the pages parents and coaches reach for repeatedly." image="/assets/heroes/resources-hero.svg" />

  <section>
    <div class="container stack-lg">
      <div class="section-header-clean">
        <div>
          <div class="section-kicker">Start with the pages families actually use</div>
          <h2>Keep the Arizona league layer in one clean resource hub.</h2>
        </div>
        <div class="section-header-copy"><p>Use the directory, rules, boundaries, age chart, and conduct pages here instead of scattering families across multiple sites.</p></div>
      </div>
      <ResourceCards />
    </div>
  </section>
</BaseLayout>
