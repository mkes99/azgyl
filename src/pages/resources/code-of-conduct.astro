---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { codeOfConductItems } from '@/data/code-of-conduct';
---
<BaseLayout title="Code of Conduct | AZGYL" pathname="/resources">
  <PageHero eyebrow="Code of conduct" title="Set the tone early and enforce it consistently." intro="Great youth sports environments do not happen by accident. AZGYL publishes conduct expectations for players, parents, and coaches so the culture is clear before conflict starts." image="/assets/heroes/resources-hero.svg" />
  <section>
    <div class="container section-block stack-lg">
      <FaqAccordion items={codeOfConductItems} />
    </div>
  </section>
</BaseLayout>
