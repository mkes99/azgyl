---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';

const items = [
  { q: 'Player expectations', a: 'Players are expected to respect teammates, coaches, officials, and opponents; learn the rules; avoid profanity; and compete with sportsmanship whether they win or lose.' },
  { q: 'Parent expectations', a: 'Parents should support effort, avoid coaching from the sideline, respect officials and coaches, keep the environment positive, and take time to cool down before escalating concerns.' },
  { q: 'Coach expectations', a: 'Coaches set the tone. They are expected to teach age-appropriate skills, protect player wellbeing, model sportsmanship, and keep winning below safety and development.' },
  { q: 'Discipline and consequences', a: 'Warnings, suspensions, ejections, or removal can follow serious or repeated violations. AZGYL keeps conduct standards enforceable because rec only works when adults keep the environment stable.' },
];
---

<BaseLayout title="Code of Conduct | AZGYL" pathname="/resources">
  <PageHero eyebrow="Code of conduct" title="Set the tone early and enforce it consistently." intro="Great youth sports environments do not happen by accident. AZGYL publishes conduct expectations for players, parents, and coaches so the culture is clear before conflict starts." image="/assets/heroes/resources-hero.svg" pills={['Players', 'Parents', 'Coaches', 'Enforcement']} />
  <section>
    <div class="container section-block stack-lg">
      <FaqAccordion items={items} />
    </div>
  </section>
</BaseLayout>
