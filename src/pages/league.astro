---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import LeagueSchedule from '@/components/LeagueSchedule.astro';
import LeagueStandings from '@/components/LeagueStandings.astro';
---

<BaseLayout title="Schedule & Standings | AZGYL — Arizona Girls Youth Lacrosse" pathname="/league">
  <PageHero
    eyebrow="League"
    title="Schedule and standings."
    intro="Game schedule and division standings for the current season, updated as new games and results come in."
    image="/assets/heroes/league-hero.jpg"
  />
  <LeagueSchedule />
  <LeagueStandings />
</BaseLayout>
