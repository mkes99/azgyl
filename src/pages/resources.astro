---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ResourceCards from '@/components/ResourceCards.astro';
import AgeChart from '@/components/AgeChart.astro';
import CodeOfConduct from '@/components/CodeOfConduct.astro';
---

<BaseLayout title="Resources | AZGYL" pathname="/resources">
  <PageHero
    eyebrow="Resources"
    title="The Arizona league layer, all in one place."
    intro="Teams, rules, boundaries, age groups, and conduct standards — everything AZGYL owns."
    image="/assets/heroes/resources-hero.svg"
  />

  <section>
    <div class="container stack-lg">
      <ResourceCards />
    </div>
  </section>

  <section class="section-alt" id="age-chart">
    <div class="container two-col split-balanced">
      <div class="copy age-chart-summary stack-lg">
        <div class="section-kicker">Age groups</div>
        <h2 class="section-heading section-heading--plain">Grade-first division guide.</h2>
        <p>Use this as the parent-friendly starting point. Final placement can depend on school affiliation, roster needs, and league policy.</p>
        <div class="actions">
          <a class="button button-primary" href="/assets/docs/azgyl-age-chart-2026.pdf" target="_blank" rel="noreferrer">Download 2026 PDF</a>
        </div>
      </div>
      <AgeChart />
    </div>
  </section>

  <section id="code-of-conduct">
    <div class="container section-block stack-lg">
      <div class="section-header-clean">
        <div>
          <div class="section-kicker">Code of conduct</div>
          <h2>Set the tone early and keep it consistent.</h2>
        </div>
        <div class="section-header-copy">
          <p>AZGYL publishes conduct expectations for players, parents, and coaches. All participants must sign before the first game of each season.</p>
        </div>
      </div>
      <CodeOfConduct />
    </div>
  </section>
</BaseLayout>
