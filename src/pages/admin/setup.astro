---
// Renders the repo's GOOGLE_SHEETS_SETUP.md directly — one source of
// truth, no content to keep in sync between the repo doc and this page.
// This page is meant to be gated by Cloudflare Access (see README.md,
// "Admin instructions page") — noindex below is just a courtesy in case
// Access isn't configured yet, it isn't the actual protection.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Content } from '../../../GOOGLE_SHEETS_SETUP.md';
---

<BaseLayout
  title="Schedule Setup Instructions | AZGYL"
  pathname="/admin/setup"
  noindex={true}
>
  <section class="admin-doc-section">
    <div class="container">
      <div class="admin-doc-banner">
        <strong>Internal reference.</strong> This page mirrors
        <code>GOOGLE_SHEETS_SETUP.md</code> in the codebase — it's meant to be
        access-restricted (see the README), not linked from the public site.
      </div>
      <article class="admin-doc prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .admin-doc-section { padding: clamp(32px, 5vw, 56px) 0 clamp(64px, 8vw, 96px); }

  .admin-doc-banner {
    max-width: 760px;
    margin: 0 auto 2rem;
    padding: .85rem 1.1rem;
    background: var(--rose-bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: .88rem;
    color: var(--muted);
  }
  .admin-doc-banner code {
    background: var(--surface-soft);
    padding: .1rem .35rem;
    border-radius: 5px;
    font-size: .85em;
  }

  .prose {
    max-width: 760px;
    margin: 0 auto;
    color: var(--text);
    line-height: 1.65;
  }
  .prose :global(h1) {
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -.01em;
    margin: 0 0 1.5rem;
  }
  .prose :global(h2) {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--rose-deep);
    margin: 2.6rem 0 1rem;
    padding-top: 1.6rem;
    border-top: 2px solid var(--line);
  }
  .prose :global(h2:first-of-type) { margin-top: 0; padding-top: 0; border-top: none; }
  .prose :global(h3) {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--olive);
    margin: 1.8rem 0 .7rem;
  }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1rem; padding-left: 1.3rem; }
  .prose :global(li) { margin-bottom: .4rem; }
  .prose :global(a) { color: var(--rose-deep); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(strong) { color: var(--text); font-weight: 700; }
  .prose :global(code) {
    background: var(--surface-soft);
    padding: .12rem .4rem;
    border-radius: 6px;
    font-size: .85em;
    color: var(--rose-deep);
  }
  .prose :global(pre) {
    padding: 1rem 1.1rem !important;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    margin: 0 0 1.2rem;
    overflow-x: auto;
    font-size: .82rem;
    line-height: 1.55;
    /* Several of these (the ASCII diagram, wide TSV examples) are wider
       than the column — macOS hides scrollbars until you touch the
       trackpad, so without this a wide block just looks cut off rather
       than scrollable. Explicit light color, not var(--line-strong):
       that's a dark semi-transparent tone meant for light backgrounds,
       invisible against the code block's dark (github-dark) theme. */
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.35) transparent;
  }
  .prose :global(pre::-webkit-scrollbar) { height: 8px; }
  .prose :global(pre::-webkit-scrollbar-track) { background: transparent; }
  .prose :global(pre::-webkit-scrollbar-thumb) {
    background: rgba(255, 255, 255, 0.35);
    border-radius: 4px;
  }
  .prose :global(pre::-webkit-scrollbar-thumb:hover) {
    background: rgba(255, 255, 255, 0.5);
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
    font-size: 1em;
  }
  .prose :global(blockquote) {
    margin: 0 0 1rem;
    padding: .3rem 0 .3rem 1rem;
    border-left: 3px solid var(--line-strong);
    color: var(--muted);
    font-style: italic;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.2rem;
    font-size: .88rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--line);
    padding: .55rem .7rem;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    background: var(--surface-soft);
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2.4rem 0;
  }
  .prose :global(a[href^="http"])::after { content: ' ↗'; font-size: .8em; }
</style>
