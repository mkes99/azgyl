---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
---

<BaseLayout title="Parent Role | AZGYL" pathname="/parents">
  <PageHero eyebrow="Parent role" title="Support the player. Do not become the second coach." intro="Parents shape the game-day experience more than they think. The goal is simple: keep the sideline positive, keep the player safe, and let the coaching staff coach." image="/assets/heroes/parents-hero.svg" />
  <section>
    <div class="container two-col split-balanced">
      <div class="copy stack-md">
        <div class="section-kicker">What helps</div>
        <h2 class="section-heading">The behaviors that make youth sports better</h2>
        <ul class="checklist">
          <li>Get your player to practices and games on time.</li>
          <li>Fuel the day with water, breakfast, and a simple snack plan.</li>
          <li>Be a good fan — your child reads your sideline behavior fast.</li>
          <li>Trust that coaches are making decisions with safety and development in mind.</li>
          <li>Remember that many officials are still learning too. Be kind.</li>
        </ul>
      </div>
      <div class="copy stack-md">
        <div class="section-kicker">What hurts</div>
        <h2 class="section-heading">The habits that make rec harder than it needs to be</h2>
        <ul class="checklist">
          <li>Coaching from the sideline or correcting every mistake in real time.</li>
          <li>Using officials as the emotional outlet for a close game.</li>
          <li>Treating rec lacrosse like a recruiting contest.</li>
          <li>Escalating a problem immediately instead of giving it a cooling-off window.</li>
          <li>Making the player responsible for adult frustration.</li>
        </ul>
      </div>
    </div>
  </section>


  <section class="section-alt" id="expectations">
    <div class="container two-col split-balanced">
      <div class="copy stack-md">
        <div class="section-kicker">Parent expectations</div>
        <h2 class="section-heading">What AZGYL expects from adults around the field.</h2>
        <ul class="checklist">
          <li>Respect coaches, officials, opponents, and other families.</li>
          <li>Do not coach from the sideline or use your player as a go-between.</li>
          <li>Bring concerns through the right channel and let emotions cool first.</li>
          <li>Model composure. Players notice adult behavior before they hear adult advice.</li>
        </ul>
      </div>
      <div class="copy stack-md">
        <div class="section-kicker">Communication</div>
        <h2 class="section-heading">Use the right lane for questions and conflict.</h2>
        <p>Start with the team or coach for normal season questions. Use league leadership or the contact form when the issue affects conduct, placement, eligibility, or safety.</p>
        <div class="actions"><a class="button button-primary button-sm" href="/contact">Contact AZGYL</a></div>
      </div>
    </div>
  </section>

</BaseLayout>
