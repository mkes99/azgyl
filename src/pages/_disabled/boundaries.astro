---
// DISABLED 2026-08-31 — moved out of src/pages/ (any folder starting with
// `_` is excluded from Astro's file-based routing) so /boundaries stops
// serving. Not back on the table until spring. To restore:
//   1. git mv this file back to src/pages/boundaries.astro
//   2. remove the '/boundaries' entry from `redirects` in astro.config.mjs
//   3. restore the 'Boundaries' row in resourceNav (src/data/site-meta.ts)
//      and the links removed from resource-cards.ts / committees.ts
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ExpansionChips from '@/components/ExpansionChips.astro';
---

<BaseLayout title="Boundaries & Service Areas | AZGYL — Arizona Girls Youth Lacrosse" pathname="/boundaries">
  <PageHero
    eyebrow="Boundaries"
    title="Draft boundaries should be visible before they are final."
    intro="AZGYL will publish school-based and district-based placement rules here once boundaries are ratified. Until then, use the team directory to find the nearest current option."
    image="/assets/heroes/boundaries-hero.jpg"
  />

  <section>
    <div class="container two-col">
      <div class="copy stack-md">
        <div class="section-kicker">Current approach</div>
        <h2 class="section-heading">Use team-first placement now.</h2>
        <p>Until the final school-district map is approved, AZGYL shows draft service areas and points families to the nearest current team option.</p>
        <ExpansionChips />
      </div>
      <div>
        <img class="boundary-map" src="/assets/graphics/arizona-zones.svg" alt="Draft Arizona service area placeholder map" />
      </div>
    </div>
  </section>
</BaseLayout>
